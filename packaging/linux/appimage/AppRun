#!/bin/sh
# SPDX-License-Identifier: LGPL-3.0-or-later
# The AppImage's entry point, in place of linuxdeploy's default.
#
# It runs usr/bin/lrr-portable, whatever the AppImage file or a symlink to it
# is called, and leaves the working directory as the caller set it: the game
# opens LegoRR0.wad and LegoRR1.wad there unless LegoRR.ini's diskpath names
# another directory.
HERE="$(dirname "$(readlink -f "${0}")")"

# Prefer the bundled binaries and libraries.
export PATH="${HERE}/usr/bin:${PATH}"
export LD_LIBRARY_PATH="${HERE}/usr/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

exec "${HERE}/usr/bin/lrr-portable" "$@"
