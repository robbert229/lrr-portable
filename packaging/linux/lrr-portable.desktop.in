[Desktop Entry]
Version=1.5

Name=@LRR_APP_NAME@
Comment=@LRR_APP_SUMMARY@

Icon=@LRR_APP_ID@
Type=Application
Categories=Game;StrategyGame;

Keywords=LEGO;Rock Raiders;LRR;

StartupWMClass=@LRR_APP_ID@
SingleMainWindow=true

TryExec=LegoRR
Exec=LegoRR
