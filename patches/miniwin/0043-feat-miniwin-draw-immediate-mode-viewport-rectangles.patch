+
+// ---- immediate mode ---------------------------------------------------------
+
+// Immediate mode's vertices arrive transformed, lit and in clip space: the CPU
+// does Direct3D's transform and lighting (immediatemode.cpp), as for a
+// DirectX 6 HAL device without hardware T&L, exactly as the software and SDL
+// GPU backends do. Colours are interpolated linearly on screen, as Gouraud
+// shading was: GLSL ES 3.00 has no noperspective, so they travel multiplied
+// by w and are divided by the interpolated w. Texture coordinates and the
+// view depth are perspective-correct.
+static const char* const ImmediateVertexShaderSource = R"(#version 300 es
+	precision highp float;
+
+	layout(location = 0) in vec4 a_position; // clip space, Direct3D's z in [0, w]
+	layout(location = 1) in vec4 a_diffuse;
+	layout(location = 2) in vec4 a_specular; // alpha carries the vertex fog factor
+	layout(location = 3) in vec2 a_texCoord;
+
+	// Half a pixel right and down, in clip-space units per unit of w:
+	// Direct3D samples pixels at integer coordinates, OpenGL at their centres.
+	uniform vec2 u_pixelOffset;
+
+	out vec4 v_diffuse;
+	out vec4 v_specular;
+	out float v_w;
+	out vec2 v_texCoord;
+	out float v_viewZ;
+
+	void main() {
+		float w = a_position.w;
+		// Direct3D's depth z / w in [0, 1] is OpenGL's window depth.
+		gl_Position = vec4(a_position.x + u_pixelOffset.x * w, a_position.y + u_pixelOffset.y * w,
+						   2.0 * a_position.z - w, w);
+		v_diffuse = a_diffuse * w;
+		v_specular = a_specular * w;
+		v_w = w;
+		v_texCoord = a_texCoord;
+		v_viewZ = w;
+	}
+)";
+
+// Immediate mode's pixel pipeline: texture stage 0, the specular colour and
+// fog, as the software backend computes them (and the SDL GPU backend's
+// ImmediatePixel.frag.hlsl). Blending and the depth test are the context's.
+static const char* const ImmediateFragmentShaderSource = R"(#version 300 es
+	precision highp float;
+	precision highp int;
+
+	// Direct3D's values for the states this shader reads.
+	const int D3DTA_SELECTMASK = 0x0f;
+	const int D3DTA_TEXTURE = 0x02;
+	const int D3DTA_TFACTOR = 0x03;
+	const int D3DTA_SPECULAR = 0x04;
+	const int D3DTA_COMPLEMENT = 0x10;
+	const int D3DTA_ALPHAREPLICATE = 0x20;
+
+	const int D3DTOP_DISABLE = 1;
+	const int D3DTOP_SELECTARG1 = 2;
+	const int D3DTOP_SELECTARG2 = 3;
+	const int D3DTOP_MODULATE2X = 5;
+	const int D3DTOP_MODULATE4X = 6;
+	const int D3DTOP_ADD = 7;
+
+	const int D3DFOG_EXP = 1;
+	const int D3DFOG_EXP2 = 2;
+	const int D3DFOG_LINEAR = 3;
+
+	const int FOG_NONE = 0;
+	const int FOG_VERTEX = 1;
+
+	in vec4 v_diffuse;
+	in vec4 v_specular;
+	in float v_w;
+	in vec2 v_texCoord;
+	in float v_viewZ;
+
+	uniform highp sampler2D u_texture;
+	uniform bool u_useTexture;
+	uniform bool u_keyed;          // alpha-0 texels stand for a colour key
+	uniform bool u_colorKeyEnable; // and are not drawn
+	uniform bool u_linear;
+	uniform int u_colorOp;
+	uniform ivec2 u_colorArgs;
+	uniform int u_alphaOp;
+	uniform ivec2 u_alphaArgs;
+	uniform bool u_specularEnable;
+	uniform int u_fogKind;
+	uniform int u_fogMode;
+	uniform vec3 u_fogParams; // start, end, density
+	uniform vec3 u_fogColor;
+	uniform float u_diffuseAlpha; // the material's, for the whole draw
+
+	out vec4 fragColor;
+
+	ivec2 TextureSize() {
+		return textureSize(u_texture, 0);
+	}
+
+	// The texel at a wrapped integer position.
+	vec4 Texel(float x, float y) {
+		ivec2 size = TextureSize();
+		int ix = int(mod(x, float(size.x)));
+		int iy = int(mod(y, float(size.y)));
+		return texelFetch(u_texture, ivec2(ix, iy), 0);
+	}
+
+	// Stage 0's texel at (u, v), wrapped, point or bilinear. A keyed texture's
+	// alpha-0 texels are the colour key: with COLORKEYENABLE they are not
+	// drawn (and do not bleed into a filtered neighbour), and the texels that
+	// are drawn are opaque.
+	vec4 SampleTexture(vec2 uv, out bool discardTexel) {
+		discardTexel = false;
+		ivec2 size = TextureSize();
+		float fx = uv.x * float(size.x);
+		float fy = uv.y * float(size.y);
+		if (!u_linear) {
+			vec4 t = Texel(floor(fx), floor(fy));
+			if (u_keyed) {
+				discardTexel = u_colorKeyEnable && t.a == 0.0;
+				t.a = 1.0;
+			}
+			return t;
+		}
+
+		fx -= 0.5;
+		fy -= 0.5;
+		float x0 = floor(fx);
+		float y0 = floor(fy);
+		float ax = fx - x0;
+		float ay = fy - y0;
+		vec4 t[4];
+		t[0] = Texel(x0, y0);
+		t[1] = Texel(x0 + 1.0, y0);
+		t[2] = Texel(x0, y0 + 1.0);
+		t[3] = Texel(x0 + 1.0, y0 + 1.0);
+		float w[4];
+		w[0] = (1.0 - ax) * (1.0 - ay);
+		w[1] = ax * (1.0 - ay);
+		w[2] = (1.0 - ax) * ay;
+		w[3] = ax * ay;
+		bool keyOut = u_keyed && u_colorKeyEnable;
+		vec4 o = vec4(0.0);
+		float coverage = 0.0;
+		for (int i = 0; i < 4; ++i) {
+			float wi = keyOut ? w[i] * t[i].a : w[i];
+			o.rgb += wi * t[i].rgb;
+			o.a += w[i] * t[i].a;
+			coverage += wi;
+		}
+		if (keyOut) {
+			if (coverage < 0.5) {
+				discardTexel = true;
+				return o;
+			}
+			return vec4(o.rgb / coverage, 1.0);
+		}
+		if (u_keyed) {
+			o.a = 1.0;
+		}
+		return o;
+	}
+
+	// A texture stage argument. Stage 0's CURRENT is the diffuse colour.
+	float StageArg(int arg, float diffuse, float texel, float diffuseAlpha, float texelAlpha) {
+		bool alpha = (arg & D3DTA_ALPHAREPLICATE) != 0;
+		float value;
+		int select = arg & D3DTA_SELECTMASK;
+		if (select == D3DTA_TEXTURE) {
+			value = alpha ? texelAlpha : texel;
+		}
+		else if (select == D3DTA_TFACTOR) {
+			value = 1.0;
+		}
+		else if (select == D3DTA_SPECULAR) {
+			value = 0.0;
+		}
+		else { // DIFFUSE, CURRENT
+			value = alpha ? diffuseAlpha : diffuse;
+		}
+		return (arg & D3DTA_COMPLEMENT) != 0 ? 1.0 - value : value;
+	}
+
+	float StageOp(int op, float arg1, float arg2, float current) {
+		if (op == D3DTOP_DISABLE) {
+			return current;
+		}
+		if (op == D3DTOP_SELECTARG1) {
+			return arg1;
+		}
+		if (op == D3DTOP_SELECTARG2) {
+			return arg2;
+		}
+		if (op == D3DTOP_MODULATE2X) {
+			return min(1.0, 2.0 * arg1 * arg2);
+		}
+		if (op == D3DTOP_MODULATE4X) {
+			return min(1.0, 4.0 * arg1 * arg2);
+		}
+		if (op == D3DTOP_ADD) {
+			return min(1.0, arg1 + arg2);
+		}
+		return arg1 * arg2; // MODULATE
+	}
+
+	float Stage(int op, ivec2 args, float diffuse, float texel, float diffuseAlpha, float texelAlpha) {
+		return StageOp(
+			op,
+			StageArg(args.x, diffuse, texel, diffuseAlpha, texelAlpha),
+			StageArg(args.y, diffuse, texel, diffuseAlpha, texelAlpha),
+			diffuse
+		);
+	}
+
+	// Direct3D's fog factor at view depth z: 1 leaves the colour, 0 is all fog.
+	float FogFactor(float z) {
+		float start = u_fogParams.x;
+		float end = u_fogParams.y;
+		float density = u_fogParams.z;
+		float f = 1.0;
+		if (u_fogMode == D3DFOG_LINEAR) {
+			f = end != start ? (end - z) / (end - start) : (z < start ? 1.0 : 0.0);
+		}
+		else if (u_fogMode == D3DFOG_EXP) {
+			f = exp(-density * z);
+		}
+		else if (u_fogMode == D3DFOG_EXP2) {
+			f = exp(-(density * z) * (density * z));
+		}
+		return clamp(f, 0.0, 1.0);
+	}
+
+	void main() {
+		vec4 diffuse = v_diffuse / v_w;
+		vec4 specular = v_specular / v_w;
+		vec3 color = diffuse.rgb;
+		float alpha = u_diffuseAlpha;
+
+		if (u_useTexture) {
+			bool discardTexel;
+			vec4 t = SampleTexture(v_texCoord, discardTexel);
+			if (discardTexel) {
+				discard;
+			}
+			color.r = Stage(u_colorOp, u_colorArgs, color.r, t.r, u_diffuseAlpha, t.a);
+			color.g = Stage(u_colorOp, u_colorArgs, color.g, t.g, u_diffuseAlpha, t.a);
+			color.b = Stage(u_colorOp, u_colorArgs, color.b, t.b, u_diffuseAlpha, t.a);
+			alpha = Stage(u_alphaOp, u_alphaArgs, u_diffuseAlpha, t.a, u_diffuseAlpha, t.a);
+		}
+		if (u_specularEnable) {
+			color = min(vec3(1.0), color + specular.rgb);
+		}
+		if (u_fogKind != FOG_NONE) {
+			float f = u_fogKind == FOG_VERTEX ? specular.a : FogFactor(v_viewZ);
+			color = f * color + (1.0 - f) * u_fogColor;
+		}
+		fragColor = vec4(color, alpha);
+	}
+)";
+
+bool OpenGLES3Renderer::CreateImmediateProgram()
+{
+	GLuint vs = CompileShader(GL_VERTEX_SHADER, ImmediateVertexShaderSource);
+	GLuint fs = CompileShader(GL_FRAGMENT_SHADER, ImmediateFragmentShaderSource);
+	if (!vs || !fs) {
+		glDeleteShader(vs);
+		glDeleteShader(fs);
+		return false;
+	}
+	GLuint program = glCreateProgram();
+	glAttachShader(program, vs);
+	glAttachShader(program, fs);
+	glLinkProgram(program);
+	glDeleteShader(vs);
+	glDeleteShader(fs);
+	GLint linked = GL_FALSE;
+	glGetProgramiv(program, GL_LINK_STATUS, &linked);
+	if (!linked) {
+		GLint logLength = 0;
+		glGetProgramiv(program, GL_INFO_LOG_LENGTH, &logLength);
+		std::vector<char> log(logLength > 0 ? logLength : 1, '\0');
+		glGetProgramInfoLog(program, (GLsizei) log.size(), nullptr, log.data());
+		SDL_LogError(LOG_CATEGORY_MINIWIN, "Immediate-mode program link error: %s", log.data());
+		glDeleteProgram(program);
+		return false;
+	}
+	m_immediateProgram = program;
+
+	m_imPixelOffsetLoc = glGetUniformLocation(program, "u_pixelOffset");
+	m_imTextureLoc = glGetUniformLocation(program, "u_texture");
+	m_imUseTextureLoc = glGetUniformLocation(program, "u_useTexture");
+	m_imKeyedLoc = glGetUniformLocation(program, "u_keyed");
+	m_imColorKeyEnableLoc = glGetUniformLocation(program, "u_colorKeyEnable");
+	m_imLinearLoc = glGetUniformLocation(program, "u_linear");
+	m_imColorOpLoc = glGetUniformLocation(program, "u_colorOp");
+	m_imColorArgsLoc = glGetUniformLocation(program, "u_colorArgs");
+	m_imAlphaOpLoc = glGetUniformLocation(program, "u_alphaOp");
+	m_imAlphaArgsLoc = glGetUniformLocation(program, "u_alphaArgs");
+	m_imSpecularLoc = glGetUniformLocation(program, "u_specularEnable");
+	m_imFogKindLoc = glGetUniformLocation(program, "u_fogKind");
+	m_imFogModeLoc = glGetUniformLocation(program, "u_fogMode");
+	m_imFogParamsLoc = glGetUniformLocation(program, "u_fogParams");
+	m_imFogColorLoc = glGetUniformLocation(program, "u_fogColor");
+	m_imDiffuseAlphaLoc = glGetUniformLocation(program, "u_diffuseAlpha");
+	glUseProgram(program);
+	glUniform1i(m_imTextureLoc, 0);
+
+	glGenVertexArrays(1, &m_immediateVAO);
+	glGenBuffers(1, &m_immediateVBO);
+	glBindVertexArray(m_immediateVAO);
+	glBindBuffer(GL_ARRAY_BUFFER, m_immediateVBO);
+	const GLsizei stride = sizeof(ImmediateGLES3Vertex);
+	glEnableVertexAttribArray(0);
+	glVertexAttribPointer(0, 4, GL_FLOAT, GL_FALSE, stride, (const void*) offsetof(ImmediateGLES3Vertex, position));
+	glEnableVertexAttribArray(1);
+	glVertexAttribPointer(
+		1,
+		4,
+		GL_UNSIGNED_BYTE,
+		GL_TRUE,
+		stride,
+		(const void*) offsetof(ImmediateGLES3Vertex, diffuse)
+	);
+	glEnableVertexAttribArray(2);
+	glVertexAttribPointer(
+		2,
+		4,
+		GL_UNSIGNED_BYTE,
+		GL_TRUE,
+		stride,
+		(const void*) offsetof(ImmediateGLES3Vertex, specular)
+	);
+	glEnableVertexAttribArray(3);
+	glVertexAttribPointer(3, 2, GL_FLOAT, GL_FALSE, stride, (const void*) offsetof(ImmediateGLES3Vertex, texCoord));
+	glBindVertexArray(0);
+	glBindBuffer(GL_ARRAY_BUFFER, 0);
+	return true;
+}
+
+// A Direct3D blend factor. The render target stands for the display surface,
+// which has no alpha channel: destination alpha reads as one.
+static GLenum ImmediateBlendFactor(DWORD factor)
+{
+	switch (static_cast<D3DBLEND>(factor)) {
+	case D3DBLEND_ZERO:
+		return GL_ZERO;
+	case D3DBLEND_ONE:
+		return GL_ONE;
+	case D3DBLEND_SRCCOLOR:
+		return GL_SRC_COLOR;
+	case D3DBLEND_INVSRCCOLOR:
+		return GL_ONE_MINUS_SRC_COLOR;
+	case D3DBLEND_SRCALPHA:
+		return GL_SRC_ALPHA;
+	case D3DBLEND_INVSRCALPHA:
+		return GL_ONE_MINUS_SRC_ALPHA;
+	case D3DBLEND_DESTALPHA:
+		return GL_ONE;
+	case D3DBLEND_INVDESTALPHA:
+		return GL_ZERO;
+	case D3DBLEND_DESTCOLOR:
+		return GL_DST_COLOR;
+	case D3DBLEND_INVDESTCOLOR:
+		return GL_ONE_MINUS_DST_COLOR;
+	case D3DBLEND_SRCALPHASAT:
+		return GL_ZERO; // min(source alpha, 1 - destination alpha)
+	default:
+		return GL_ONE;
+	}
+}
+
+// A Direct3D z comparison. The depth buffer holds Direct3D's z / w.
+static GLenum ImmediateDepthFunc(DWORD func)
+{
+	switch (static_cast<D3DCMPFUNC>(func)) {
+	case D3DCMP_NEVER:
+		return GL_NEVER;
+	case D3DCMP_LESS:
+		return GL_LESS;
+	case D3DCMP_EQUAL:
+		return GL_EQUAL;
+	case D3DCMP_LESSEQUAL:
+		return GL_LEQUAL;
+	case D3DCMP_GREATER:
+		return GL_GREATER;
+	case D3DCMP_NOTEQUAL:
+		return GL_NOTEQUAL;
+	case D3DCMP_GREATEREQUAL:
+		return GL_GEQUAL;
+	default:
+		return GL_ALWAYS;
+	}
+}
+
+void OpenGLES3Renderer::SetGLViewportAndScissor(const SDL_Rect& rect)
+{
+	const GLint y = m_height - rect.y - rect.h;
+	glViewport(rect.x, y, rect.w, rect.h);
+	glEnable(GL_SCISSOR_TEST);
+	glScissor(rect.x, y, rect.w, rect.h);
+}
+
+// The draw's vertices are lit and culled exactly as the software backend does
+// it (immediatemode.cpp); OpenGL clips and rasterizes them, at once.
+HRESULT OpenGLES3Renderer::SubmitImmediate(const ImmediateDraw& draw)
+{
+	if (!m_immediateProgram) {
+		return DDERR_GENERIC;
+	}
+	SDL_GL_MakeCurrent(DDWindow, m_context);
+	const ImmediateShading shading = DecodeImmediateShading(*draw.state);
+
+	m_immediateVertices.clear();
+	const D3DRMMATRIX4D& p = m_projection;
+	m_transformer.Run(draw, m_preparedLights, shading, [&](const ImmediateLitVertex(&triangle)[3]) {
+		for (const ImmediateLitVertex& v : triangle) {
+			const D3DVECTOR& e = v.position;
+			ImmediateGLES3Vertex out;
+			for (int c = 0; c < 4; ++c) {
+				out.position[c] = p[0][c] * e.x + p[1][c] * e.y + p[2][c] * e.z + p[3][c];
+			}
+			out.diffuse = v.color;
+			out.specular = v.specular;
+			out.texCoord = v.texCoord;
+			m_immediateVertices.push_back(out);
+		}
+	});
+	if (m_immediateVertices.empty() || m_viewportRect.w <= 0 || m_viewportRect.h <= 0) {
+		return DD_OK;
+	}
+
+	GLuint glTexture = m_dummyTexture;
+	bool useTexture = false;
+	bool keyed = false;
+	if (draw.texture && shading.colorOp != static_cast<DWORD>(D3DTOP_DISABLE)) {
+		Uint32 textureId = GetTextureId(draw.texture, false, 1.0f, 1.0f);
+		if (textureId != NO_TEXTURE_ID && m_textures[textureId].glTextureId) {
+			glTexture = m_textures[textureId].glTextureId;
+			useTexture = true;
+			keyed = m_textures[textureId].keyed;
+		}
+	}
+
+	m_dirty = true;
+	m_retainedStateLost = true;
+	glBindFramebuffer(GL_FRAMEBUFFER, m_fbo);
+	glUseProgram(m_immediateProgram);
+	SetGLViewportAndScissor(m_viewportRect);
+
+	// Culling is done on the CPU, with the transform and lighting.
+	glDisable(GL_CULL_FACE);
+	if (shading.zEnable) {
+		glEnable(GL_DEPTH_TEST);
+		glDepthFunc(ImmediateDepthFunc(shading.zFunc));
+		glDepthMask(shading.zWrite ? GL_TRUE : GL_FALSE);
+	}
+	else {
+		glDisable(GL_DEPTH_TEST);
+	}
+	if (shading.blend) {
+		glEnable(GL_BLEND);
+		glBlendFuncSeparate(
+			ImmediateBlendFactor(shading.srcBlend),
+			ImmediateBlendFactor(shading.destBlend),
+			GL_ZERO,
+			GL_ONE
+		);
+	}
+	else {
+		glDisable(GL_BLEND);
+	}
+	// The target's alpha is never written: the display surface has none.
+	glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_FALSE);
+
+	glUniform2f(m_imPixelOffsetLoc, 1.0f / m_viewportRect.w, -1.0f / m_viewportRect.h);
+	glUniform1i(m_imUseTextureLoc, useTexture ? 1 : 0);
+	glUniform1i(m_imKeyedLoc, keyed ? 1 : 0);
+	glUniform1i(m_imColorKeyEnableLoc, shading.colorKeyEnable ? 1 : 0);
+	glUniform1i(m_imLinearLoc, shading.linear ? 1 : 0);
+	glUniform1i(m_imColorOpLoc, static_cast<GLint>(shading.colorOp));
+	glUniform2i(m_imColorArgsLoc, static_cast<GLint>(shading.colorArg1), static_cast<GLint>(shading.colorArg2));
+	glUniform1i(m_imAlphaOpLoc, static_cast<GLint>(shading.alphaOp));
+	glUniform2i(m_imAlphaArgsLoc, static_cast<GLint>(shading.alphaArg1), static_cast<GLint>(shading.alphaArg2));
+	glUniform1i(m_imSpecularLoc, shading.specular ? 1 : 0);
+	glUniform1i(m_imFogKindLoc, static_cast<GLint>(shading.fog));
+	glUniform1i(m_imFogModeLoc, static_cast<GLint>(shading.fogMode));
+	glUniform3f(m_imFogParamsLoc, shading.fogStart, shading.fogEnd, shading.fogDensity);
+	glUniform3f(m_imFogColorLoc, shading.fogR, shading.fogG, shading.fogB);
+	// The lit colour's alpha is the material's, the same for the whole draw.
+	const float alpha = std::min(1.0f, std::max(0.0f, draw.material.diffuse.a));
+	glUniform1f(m_imDiffuseAlphaLoc, static_cast<Uint8>(alpha * 255.0f + 0.5f) / 255.0f);
+
+	glActiveTexture(GL_TEXTURE0);
+	glBindTexture(GL_TEXTURE_2D, glTexture);
+
+	glBindVertexArray(m_immediateVAO);
+	glBindBuffer(GL_ARRAY_BUFFER, m_immediateVBO);
+	glBufferData(
+		GL_ARRAY_BUFFER,
+		m_immediateVertices.size() * sizeof(ImmediateGLES3Vertex),
+		m_immediateVertices.data(),
+		GL_STREAM_DRAW
+	);
+	glDrawArrays(GL_TRIANGLES, 0, static_cast<GLsizei>(m_immediateVertices.size()));
+	glBindVertexArray(0);
+	glBindBuffer(GL_ARRAY_BUFFER, 0);
+	return DD_OK;
+}
+
+SDL_Rect OpenGLES3Renderer::ToRenderPixels(const D3DRECT& rect) const
+{
+	float scale = m_viewportTransform.scale;
+	int x1 = static_cast<int>(std::lround(rect.x1 * scale + m_viewportTransform.offsetX));
+	int y1 = static_cast<int>(std::lround(rect.y1 * scale + m_viewportTransform.offsetY));
+	int x2 = static_cast<int>(std::lround(rect.x2 * scale + m_viewportTransform.offsetX));
+	int y2 = static_cast<int>(std::lround(rect.y2 * scale + m_viewportTransform.offsetY));
+	SDL_Rect fit = GetFitRect();
+	x1 = std::max(fit.x, std::min(x1, fit.x + fit.w));
+	y1 = std::max(fit.y, std::min(y1, fit.y + fit.h));
+	x2 = std::max(x1, std::min(x2, fit.x + fit.w));
+	y2 = std::max(y1, std::min(y2, fit.y + fit.h));
+	return {x1, y1, x2 - x1, y2 - y1};
+}
+
+void OpenGLES3Renderer::SetViewportRect(const D3DRECT* rect)
+{
+	m_viewportRect = rect ? ToRenderPixels(*rect) : SDL_Rect{0, 0, m_width, m_height};
+	m_retainedStateLost = true;
+}
+
+// OpenGL clears a scissored rectangle of the target and of the depth buffer
+// directly. The depth buffer holds Direct3D's z / w for immediate-mode draws,
+// so z is stored as it is; the far plane, 1, is the far plane for retained
+// mode too.
+HRESULT OpenGLES3Renderer::ClearRect(const D3DRECT& rect, DWORD flags, D3DCOLOR color, float z)
+{
+	const bool target = (flags & D3DCLEAR_TARGET) != 0;
+	const bool zbuffer = (flags & D3DCLEAR_ZBUFFER) != 0;
+	if (!target && !zbuffer) {
+		return DD_OK;
+	}
+	SDL_Rect pixels = ToRenderPixels(rect);
+	if (pixels.w <= 0 || pixels.h <= 0) {
+		return DD_OK;
+	}
+	SDL_GL_MakeCurrent(DDWindow, m_context);
+	m_dirty = true;
+	m_retainedStateLost = true;
+	glBindFramebuffer(GL_FRAMEBUFFER, m_fbo);
+	glEnable(GL_SCISSOR_TEST);
+	glScissor(pixels.x, m_height - pixels.y - pixels.h, pixels.w, pixels.h);
+	GLbitfield mask = 0;
+	if (target) {
+		glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+		glClearColor(
+			((color >> 16) & 0xff) / 255.0f,
+			((color >> 8) & 0xff) / 255.0f,
+			(color & 0xff) / 255.0f,
+			1.0f
+		);
+		mask |= GL_COLOR_BUFFER_BIT;
+	}
+	if (zbuffer) {
+		glDepthMask(GL_TRUE);
+		glClearDepthf(std::min(1.0f, std::max(0.0f, z)));
+		mask |= GL_DEPTH_BUFFER_BIT;
+	}
+	glClear(mask);
+	glDisable(GL_SCISSOR_TEST);
+	return DD_OK;
+}
