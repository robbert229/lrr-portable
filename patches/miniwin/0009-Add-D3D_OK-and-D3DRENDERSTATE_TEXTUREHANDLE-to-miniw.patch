From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Rowley <johnrowleyster@gmail.com>
Date: Sun, 15 Nov 2026 21:09:38 -0800
Subject: [PATCH] Add D3D_OK and D3DRENDERSTATE_TEXTUREHANDLE to miniwin

D3D_OK is the Direct3D immediate-mode success code, equal to DD_OK.
D3DRENDERSTATE_TEXTUREHANDLE (1) is the render state that holds a
texture handle on devices without texture stages.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/miniwin/include/miniwin/d3d.h b/miniwin/include/miniwin/d3d.h
index 3183b07..9d2cba5 100644
--- a/miniwin/include/miniwin/d3d.h
+++ b/miniwin/include/miniwin/d3d.h
@@ -2,6 +2,9 @@
 
 #include "miniwin/ddraw.h"
 
+// --- Defines and Macros ---
+#define D3D_OK DD_OK
+
 // --- GUIDs ---
 DEFINE_GUID(IID_IDirect3D2, 0x6aae1ec1, 0x662a, 0x11d0, 0x88, 0x9d, 0x00, 0xaa, 0x00, 0xbb, 0xb7, 0x6a);
 DEFINE_GUID(IID_IDirect3D3, 0xbb223240, 0xe72b, 0x11d0, 0xa9, 0xb4, 0x00, 0xaa, 0x00, 0xc0, 0x99, 0x3e);
@@ -105,6 +108,7 @@ enum class D3DLIGHTSTATETYPE : uint32_t {
 	COLORVERTEX = 8,
 };
 
+#define D3DRENDERSTATE_TEXTUREHANDLE D3DRENDERSTATETYPE::TEXTUREHANDLE
 #define D3DRENDERSTATE_ZENABLE D3DRENDERSTATETYPE::ZENABLE
 #define D3DRENDERSTATE_SHADEMODE D3DRENDERSTATETYPE::SHADEMODE
 #define D3DRENDERSTATE_ZWRITEENABLE D3DRENDERSTATETYPE::ZWRITEENABLE
@@ -113,6 +117,7 @@ enum class D3DLIGHTSTATETYPE : uint32_t {
 #define D3DRENDERSTATE_ALPHABLENDENABLE D3DRENDERSTATETYPE::ALPHABLENDENABLE
 #define D3DRENDERSTATE_SPECULARENABLE D3DRENDERSTATETYPE::SPECULARENABLE
 enum class D3DRENDERSTATETYPE : uint32_t {
+	TEXTUREHANDLE = 1,
 	ZENABLE = 7,
 	SHADEMODE = 9,
 	ZWRITEENABLE = 14,
