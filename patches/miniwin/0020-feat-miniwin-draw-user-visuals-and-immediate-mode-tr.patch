+			{p1, {draw.vertices[i1].tu, draw.vertices[i1].tv}, c1, none},
+			{p2, {draw.vertices[i2].tu, draw.vertices[i2].tv}, c2, none},
+		};
+		DrawImmediateClipped(tri, pixelState);
+	}
