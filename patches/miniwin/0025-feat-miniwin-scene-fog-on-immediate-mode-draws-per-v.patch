 	};
 	void DrawImmediateClipped(const SWLitVertex (&v)[3], const ImmediatePixelState& state);
 	void DrawImmediateTriangle(
diff --git a/miniwin/src/internal/d3drmviewport_impl.h b/miniwin/src/internal/d3drmviewport_impl.h
index 9ff0ee6..96eefc2 100644
