 #include "ddraw_impl.h"
 #include "ddsurface_impl.h"
@@ -320,6 +323,28 @@ HRESULT Direct3DRMImpl::LoadTexture(const char* filename, IDirect3DRMTexture3**
 	return E_NOTIMPL;
 }
 
+HRESULT Direct3DRMImpl::CreateMeshBuilder(IDirect3DRMMeshBuilder3** outMeshBuilder)
+{
+	*outMeshBuilder = static_cast<IDirect3DRMMeshBuilder3*>(new Direct3DRMMeshBuilderImpl);
+	return DD_OK;
+}
+
+HRESULT Direct3DRMImpl::CreateAnimationSet(IDirect3DRMAnimationSet2** outAnimationSet)
+{
+	*outAnimationSet = static_cast<IDirect3DRMAnimationSet2*>(new Direct3DRMAnimationSetImpl);
+	return DD_OK;
+}
+
+HRESULT Direct3DRMImpl::CreateUserVisual(
+	D3DRMUSERVISUALCALLBACK callback,
+	void* arg,
+	IDirect3DRMUserVisual** outUserVisual
+)
+{
+	*outUserVisual = static_cast<IDirect3DRMUserVisual*>(new Direct3DRMUserVisualImpl(callback, arg));
+	return DD_OK;
+}
+
 HRESULT WINAPI Direct3DRMCreate(IDirect3DRM** direct3DRM)
 {
 	*direct3DRM = new Direct3DRMImpl;
diff --git a/miniwin/src/d3drm/d3drmanimationset.cpp b/miniwin/src/d3drm/d3drmanimationset.cpp
new file mode 100644
index 0000000..748d8ad
--- /dev/null
+++ b/miniwin/src/d3drm/d3drmanimationset.cpp
@@ -0,0 +1,32 @@
+#include "d3drmanimationset_impl.h"
+#include "miniwin.h"
+
+HRESULT Direct3DRMAnimationSetImpl::QueryInterface(const GUID& riid, void** ppvObject)
+{
+	if (SDL_memcmp(&riid, &IID_IDirect3DRMAnimationSet2, sizeof(GUID)) == 0) {
+		this->IUnknown::AddRef();
+		*ppvObject = static_cast<IDirect3DRMAnimationSet2*>(this);
+		return DD_OK;
+	}
+	MINIWIN_NOT_IMPLEMENTED();
+	return E_NOINTERFACE;
+}
+
+HRESULT Direct3DRMAnimationSetImpl::Load(
+	void* filename,
+	void* name,
+	D3DRMLOADOPTIONS flags,
+	D3DRMLOADTEXTURE3CALLBACK callback,
+	void* arg,
+	IDirect3DRMFrame3* parent
+)
+{
+	MINIWIN_NOT_IMPLEMENTED();
+	return E_NOTIMPL;
+}
+
+HRESULT Direct3DRMAnimationSetImpl::SetTime(D3DVALUE time)
+{
+	MINIWIN_NOT_IMPLEMENTED();
+	return E_NOTIMPL;
+}
diff --git a/miniwin/src/d3drm/d3drmmeshbuilder.cpp b/miniwin/src/d3drm/d3drmmeshbuilder.cpp
