+struct Direct3DRMUserVisualImpl : public Direct3DRMObjectBaseImpl<IDirect3DRMUserVisual> {
+	Direct3DRMUserVisualImpl(D3DRMUSERVISUALCALLBACK callback, void* arg) : m_callback(callback), m_arg(arg) {}
