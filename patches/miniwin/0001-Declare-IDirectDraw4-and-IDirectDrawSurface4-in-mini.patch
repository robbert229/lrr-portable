+
 #define DDBLTFX_NOTEARING DDBLTFXFlags::NOTEARING
 enum class DDBLTFXFlags : uint8_t {
 	NOTEARING = 1 << 3,
@@ -294,6 +306,36 @@ struct DDSURFACEDESC {
 };
