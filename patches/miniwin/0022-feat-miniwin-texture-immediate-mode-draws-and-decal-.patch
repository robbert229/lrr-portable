+#define D3DFILTER_LINEAR D3DTEXTUREFILTER::LINEAR
+#define D3DFILTER_MIPNEAREST D3DTEXTUREFILTER::MIPNEAREST
+#define D3DFILTER_MIPLINEAR D3DTEXTUREFILTER::MIPLINEAR
+#define D3DFILTER_LINEARMIPNEAREST D3DTEXTUREFILTER::LINEARMIPNEAREST
+#define D3DFILTER_LINEARMIPLINEAR D3DTEXTUREFILTER::LINEARMIPLINEAR
+enum class D3DTEXTUREFILTER : uint32_t {
+	NEAREST = 1,
+	LINEAR = 2,
+	MIPNEAREST = 3,
+	MIPLINEAR = 4,
