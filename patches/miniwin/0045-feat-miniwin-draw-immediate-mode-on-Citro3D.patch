+++ b/miniwin/src/d3drm/backends/citro3d/immediate.v.pica
@@ -0,0 +1,20 @@
+; Immediate mode: the vertices arrive transformed, lit and in PICA's clip
+; space (Citro3DRenderer::SubmitImmediate). No uniforms or constants, so
+; that the retained-mode shader's stay as they were.
+
+; Outputs
+.out outpos position
+.out outclr color
+.out outtc0 texcoord0
+
+; Inputs
+.alias inpos v0
+.alias inclr v1
+.alias intex v2
+
+.proc main
+	mov outpos, inpos
+	mov outclr, inclr
+	mov outtc0, intex
+	end
+.end
