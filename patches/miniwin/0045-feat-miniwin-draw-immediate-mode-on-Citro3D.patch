+// Retained mode and 2D images: the mesh shader, lit on the GPU.
+void Citro3DRenderer::UseRetainedPipeline()
+{
+	if (m_pipeline == Pipeline::Retained) {
+		return;
+	}
+	m_pipeline = Pipeline::Retained;
+	C3D_BindProgram(&program);
+	C3D_AttrInfo* attrInfo = C3D_GetAttrInfo();
+	AttrInfo_Init(attrInfo);
+	AttrInfo_AddLoader(attrInfo, 0, GPU_FLOAT, 3); // v0=position
+	AttrInfo_AddLoader(attrInfo, 1, GPU_FLOAT, 3); // v1=normal
+	AttrInfo_AddLoader(attrInfo, 2, GPU_FLOAT, 2); // v2=texcoord
+	C3D_CullFace(GPU_CULL_FRONT_CCW);
+	C3D_AlphaBlend(
+		GPU_BLEND_ADD,
+		GPU_BLEND_ADD,
+		GPU_SRC_ALPHA,
+		GPU_ONE_MINUS_SRC_ALPHA,
+		GPU_SRC_ALPHA,
+		GPU_ONE_MINUS_SRC_ALPHA
+	);
+	C3D_AlphaTest(false, GPU_ALWAYS, 0);
+	C3D_TexEnvInit(C3D_GetTexEnv(1));
+	DisableFog();
+}
+
+// Immediate mode: lit and culled on the CPU (ImmediateTransformer), each
+// draw setting its own depth test, blend, texture combiners and fog.
+void Citro3DRenderer::UseImmediatePipeline()
+{
+	if (m_pipeline == Pipeline::Immediate) {
+		return;
+	}
+	m_pipeline = Pipeline::Immediate;
+	C3D_BindProgram(&immediateProgram);
+	C3D_AttrInfo* attrInfo = C3D_GetAttrInfo();
+	AttrInfo_Init(attrInfo);
+	AttrInfo_AddLoader(attrInfo, 0, GPU_FLOAT, 4); // v0=position
+	AttrInfo_AddLoader(attrInfo, 1, GPU_FLOAT, 4); // v1=color
+	AttrInfo_AddLoader(attrInfo, 2, GPU_FLOAT, 2); // v2=texcoord
+	C3D_CullFace(GPU_CULL_NONE);
+}
+
+// Draw into a rectangle of the screen, in render pixels.
+void Citro3DRenderer::SetTargetViewport(const SDL_Rect& screen)
+{
+	const SDL_Rect target = Citro3DImmediate::TargetRect(screen, m_width, m_height);
+	C3D_SetViewport(target.x, target.y, target.w, target.h);
+	if (screen.x == 0 && screen.y == 0 && screen.w == m_width && screen.h == m_height) {
+		C3D_SetScissor(GPU_SCISSOR_DISABLE, 0, 0, 0, 0);
+	}
+	else {
+		C3D_SetScissor(GPU_SCISSOR_NORMAL, target.x, target.y, target.x + target.w, target.y + target.h);
+	}
+}
