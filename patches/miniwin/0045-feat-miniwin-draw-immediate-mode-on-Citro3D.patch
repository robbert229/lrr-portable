diff --git a/miniwin/src/internal/citro3dimmediate.h b/miniwin/src/internal/citro3dimmediate.h
new file mode 100644
index 0000000..a2e108f
--- /dev/null
+++ b/miniwin/src/internal/citro3dimmediate.h
@@ -0,0 +1,233 @@
+#pragma once
+
+#include "miniwin/d3drm.h"
+
+#include <SDL3/SDL_rect.h>
+
+// The arithmetic of the Citro3D backend's immediate mode, apart from citro3d
+// so that it builds, and is tested, on any host:
+// - the 3DS's framebuffers lie on their side;
+// - depth is reversed, as citro3d's own projections give retained mode, so
+//   that both share one z-buffer;
+// - texture stage 0 becomes PICA texture combiners, and a colour key an
+//   alpha test;
+// - fog is a table indexed by depth.
+namespace Citro3DImmediate {
+
+// A Direct3D clip-space position, z from 0 at the near plane to w at the far
+// one, as PICA's: x and y turned as Mtx_OrthoTilt turns them, and z/w from
+// -1 (near) to 0 (far), so that C3D_DepthMap's default (scale -1, offset 0)
+// makes the window depth 1 at the near plane and 0 at the far one.
+inline void ClipFromD3D(const float in[4], float out[4])
+{
+	out[0] = in[1];
+	out[1] = -in[0];
+	out[2] = in[2] - in[3];
+	out[3] = in[3];
+}
+
+// A rectangle of a screenWidth x screenHeight screen, from its top left, as
+// pixels of the framebuffer under it (C3D_SetViewport's): the framebuffer is
+// screenHeight wide and screenWidth high, its x along the screen's height
+// from the bottom and its y along the screen's width from the right.
+inline SDL_Rect TargetRect(const SDL_Rect& screen, int screenWidth, int screenHeight)
+{
+	return {screenHeight - (screen.y + screen.h), screenWidth - (screen.x + screen.w), screen.h, screen.w};
+}
+
+// A Direct3D depth test for the reversed depth.
+inline D3DCMPFUNC ReversedDepthFunc(D3DCMPFUNC func)
+{
+	switch (func) {
+	case D3DCMP_LESS:
+		return D3DCMP_GREATER;
+	case D3DCMP_LESSEQUAL:
+		return D3DCMP_GREATEREQUAL;
+	case D3DCMP_GREATER:
+		return D3DCMP_LESS;
+	case D3DCMP_GREATEREQUAL:
+		return D3DCMP_LESSEQUAL;
+	default:
+		return func;
+	}
+}
+
+// Texture stage 0's operations and arguments, Direct3D's values.
+struct StageState {
+	DWORD colorOp, colorArg1, colorArg2;
+	DWORD alphaOp, alphaArg1, alphaArg2;
+};
+
+// A texture combiner, in PICA's terms. The constant colour is white in
+// every stage.
+enum class Source {
+	Primary,
+	Texture,
+	Constant,
+	Previous
+};
+enum class Operand {
+	Color,
+	OneMinusColor,
+	Alpha,
+	OneMinusAlpha
+};
+enum class Func {
+	Replace,
+	Modulate,
+	Add
+};
+struct Combiner {
+	Func func = Func::Replace;
+	int scale = 1;
+	Source source[2] = {Source::Primary, Source::Primary};
+	Operand operand[2] = {Operand::Color, Operand::Color};
+};
+struct CombinerStage {
+	Combiner rgb;
+	Combiner alpha;
+};
+struct Combiners {
+	CombinerStage stage[2];
+	int count = 1;
+	// Drop the fragments whose alpha is under KeyAlphaTestRef.
+	bool alphaTest = false;
+};
+
+// One stage argument. A keyed texture's alpha is opaque (its alpha-0
+// texels stand for the key); TFACTOR is white; SPECULAR is black, as the
+// other backends have them. The alpha combiner reads every argument's alpha.
+inline void CombinerArg(DWORD arg, bool alphaCombiner, bool keyed, Source& source, Operand& operand)
+{
+	bool complement = (arg & D3DTA_COMPLEMENT) != 0;
+	const bool alpha = alphaCombiner || (arg & D3DTA_ALPHAREPLICATE) != 0;
+	switch (arg & D3DTA_SELECTMASK) {
+	case D3DTA_TEXTURE:
+		source = alpha && keyed ? Source::Constant : Source::Texture;
+		break;
+	case D3DTA_TFACTOR:
+		source = Source::Constant;
+		break;
+	case D3DTA_SPECULAR:
+		source = Source::Constant;
+		complement = !complement;
+		break;
+	default: // DIFFUSE, CURRENT
+		source = Source::Primary;
+		break;
+	}
+	if (alpha) {
+		operand = complement ? Operand::OneMinusAlpha : Operand::Alpha;
+	}
+	else {
+		operand = complement ? Operand::OneMinusColor : Operand::Color;
+	}
+}
+
+inline Combiner StageCombiner(DWORD op, DWORD arg1, DWORD arg2, bool alphaCombiner, bool keyed)
+{
+	Combiner c;
+	CombinerArg(arg1, alphaCombiner, keyed, c.source[0], c.operand[0]);
+	CombinerArg(arg2, alphaCombiner, keyed, c.source[1], c.operand[1]);
+	switch (static_cast<D3DTEXTUREOP>(op)) {
+	case D3DTOP_DISABLE: // stage 0's current: the diffuse
+		c.func = Func::Replace;
+		c.source[0] = Source::Primary;
+		c.operand[0] = alphaCombiner ? Operand::Alpha : Operand::Color;
+		break;
+	case D3DTOP_SELECTARG1:
+		c.func = Func::Replace;
+		break;
+	case D3DTOP_SELECTARG2:
+		c.func = Func::Replace;
+		c.source[0] = c.source[1];
+		c.operand[0] = c.operand[1];
+		break;
+	case D3DTOP_MODULATE2X:
+		c.func = Func::Modulate;
+		c.scale = 2;
+		break;
+	case D3DTOP_MODULATE4X:
+		c.func = Func::Modulate;
+		c.scale = 4;
+		break;
+	case D3DTOP_ADD:
+		c.func = Func::Add;
+		break;
+	default: // MODULATE, and what the other backends draw as it
+		c.func = Func::Modulate;
+		break;
+	}
+	return c;
+}
+
+// Stage 0, or the diffuse colour when the draw is untextured or COLOROP is
+// DISABLE. With COLORKEYENABLE a keyed texture's texels on the key are not
+// drawn: a second stage multiplies in the texel's alpha, 0 on the key, and
+// the alpha test drops them.
+inline Combiners PlanCombiners(const StageState& state, bool textured, bool keyed, bool colorKeyEnable)
+{
+	Combiners plan;
+	if (!textured || static_cast<D3DTEXTUREOP>(state.colorOp) == D3DTOP_DISABLE) {
+		plan.stage[0].rgb = StageCombiner(static_cast<DWORD>(D3DTOP_DISABLE), 0, 0, false, false);
+		plan.stage[0].alpha = StageCombiner(static_cast<DWORD>(D3DTOP_DISABLE), 0, 0, true, false);
+		return plan;
+	}
+	plan.stage[0].rgb = StageCombiner(state.colorOp, state.colorArg1, state.colorArg2, false, keyed);
+	plan.stage[0].alpha = StageCombiner(state.alphaOp, state.alphaArg1, state.alphaArg2, true, keyed);
+	if (keyed && colorKeyEnable) {
+		Combiner& rgb = plan.stage[1].rgb;
+		rgb.func = Func::Replace;
+		rgb.source[0] = Source::Previous;
+		Combiner& alpha = plan.stage[1].alpha;
+		alpha.func = Func::Modulate;
+		alpha.source[0] = Source::Previous;
+		alpha.operand[0] = Operand::Alpha;
+		alpha.source[1] = Source::Texture;
+		alpha.operand[1] = Operand::Alpha;
+		plan.count = 2;
+		plan.alphaTest = true;
+	}
+	return plan;
+}
+
+// The alpha test's reference for a keyed draw whose alpha, before the
+// texel's, is diffuseAlpha (0-255): texels under half covered are dropped,
+// as the other backends drop them.
+inline int KeyAlphaTestRef(int diffuseAlpha)
+{
+	return (diffuseAlpha + 1) / 2;
+}
+
+// The view-space depth at window depth `depth` (1 at the near plane, 0 at
+// the far one) under a Direct3D projection.
+inline float FogViewZ(const D3DRMMATRIX4D& p, float depth)
+{
+	const float ndc = 1.0f - depth;
+	const float denominator = ndc * p[2][3] - p[2][2];
+	if (denominator == 0.0f) {
+		return 0.0f;
+	}
+	return (p[3][2] - ndc * p[3][3]) / denominator;
+}
+
+// The fog table for FogLut_FromArray: fogFactor(viewZ) (1 leaves the colour,
+// 0 is all fog) at the 129 window depths i / 128 from the far plane, as 128
+// values and then the 128 steps from each to the next.
+template <typename FogFactor>
+void FogTable(const D3DRMMATRIX4D& p, FogFactor fogFactor, float data[256])
+{
+	float previous = 0.0f;
+	for (int i = 0; i <= 128; ++i) {
+		const float value = fogFactor(FogViewZ(p, i / 128.0f));
+		if (i < 128) {
+			data[i] = value;
+		}
+		if (i > 0) {
+			data[i + 127] = value - previous;
+		}
+		previous = value;
+	}
+}
+
+} // namespace Citro3DImmediate
