From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Rowley <johnrowleyster@gmail.com>
Date: Sun, 15 Nov 2026 18:10:52 -0800
Subject: [PATCH] Declare the DirectInput keyboard and mouse device interfaces
 in miniwin

Fill out dinput.h with IDirectInputA, IDirectInputDeviceA and
IDirectInputDevice2A, their IIDs, GUID_SysKeyboard and GUID_SysMouse,
DIDATAFORMAT, the cooperative-level flags, c_dfDIKeyboard and
DirectInputCreateA.

DirectInputCreateA returns a new DirectInputImpl, whose CreateDevice
returns a DirectInputDeviceImpl for the system keyboard or mouse and
DIERR_DEVICENOTREG for any other device. The device answers
IID_IDirectInputDeviceA and IID_IDirectInputDevice2A. Its methods log
once and return DIERR_UNSUPPORTED. c_dfDIKeyboard carries the format
header only, without the per-key object table.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/miniwin/CMakeLists.txt b/miniwin/CMakeLists.txt
index 272c651..eb3e318 100644
--- a/miniwin/CMakeLists.txt
+++ b/miniwin/CMakeLists.txt
@@ -11,6 +11,9 @@ add_library(miniwin STATIC EXCLUDE_FROM_ALL
   src/ddraw/ddsurface.cpp
   src/ddraw/framebuffer.cpp
 
+  # DInput
+  src/dinput/dinput.cpp
+
   # D3D
   src/d3d/d3dmaterial.cpp
   src/d3d/d3dviewport.cpp
diff --git a/miniwin/include/miniwin/dinput.h b/miniwin/include/miniwin/dinput.h
index ff885ca..a223db6 100644
--- a/miniwin/include/miniwin/dinput.h
+++ b/miniwin/include/miniwin/dinput.h
@@ -1,4 +1,74 @@
 #pragma once
 
-// --- Typedefs ---
-typedef struct IDirectInputA* LPDIRECTINPUTA;
+#include "miniwin/windows.h"
+
+// --- Defines and Macros ---
+#define DI_OK S_OK
+#define DIERR_INVALIDPARAM ((HRESULT) 0x80070057)
+#define DIERR_UNSUPPORTED E_NOTIMPL
+#define DIERR_DEVICENOTREG ((HRESULT) 0x80040154)
+
+#define DISCL_EXCLUSIVE 0x00000001
+#define DISCL_NONEXCLUSIVE 0x00000002
+#define DISCL_FOREGROUND 0x00000004
+#define DISCL_BACKGROUND 0x00000008
+
+#define DIDF_ABSAXIS 0x00000001
+#define DIDF_RELAXIS 0x00000002
+
+// --- GUIDs ---
+DEFINE_GUID(IID_IDirectInputA, 0x89521360, 0xaa8a, 0x11cf, 0xbf, 0xc7, 0x44, 0x45, 0x53, 0x54, 0x00, 0x00);
+DEFINE_GUID(IID_IDirectInputDeviceA, 0x5944e680, 0xc92e, 0x11cf, 0xbf, 0xc7, 0x44, 0x45, 0x53, 0x54, 0x00, 0x00);
+DEFINE_GUID(IID_IDirectInputDevice2A, 0x5944e682, 0xc92e, 0x11cf, 0xbf, 0xc7, 0x44, 0x45, 0x53, 0x54, 0x00, 0x00);
+DEFINE_GUID(GUID_SysMouse, 0x6f1d2b60, 0xd5a0, 0x11cf, 0xbf, 0xc7, 0x44, 0x45, 0x53, 0x54, 0x00, 0x00);
+DEFINE_GUID(GUID_SysKeyboard, 0x6f1d2b61, 0xd5a0, 0x11cf, 0xbf, 0xc7, 0x44, 0x45, 0x53, 0x54, 0x00, 0x00);
+
+// --- Structs ---
+struct DIOBJECTDATAFORMAT {
+	const GUID* pguid;
+	DWORD dwOfs;
+	DWORD dwType;
+	DWORD dwFlags;
+};
+typedef DIOBJECTDATAFORMAT* LPDIOBJECTDATAFORMAT;
+
+struct DIDATAFORMAT {
+	DWORD dwSize;
+	DWORD dwObjSize;
+	DWORD dwFlags;
+	DWORD dwDataSize;
+	DWORD dwNumObjs;
+	LPDIOBJECTDATAFORMAT rgodf;
+};
+typedef DIDATAFORMAT* LPDIDATAFORMAT;
+typedef const DIDATAFORMAT* LPCDIDATAFORMAT;
+
+// --- Interfaces ---
+struct IDirectInputDeviceA : virtual public IUnknown {
+	virtual HRESULT Acquire() = 0;
+	virtual HRESULT Unacquire() = 0;
+	virtual HRESULT GetDeviceState(DWORD cbData, LPVOID lpvData) = 0;
+	virtual HRESULT SetDataFormat(LPCDIDATAFORMAT lpdf) = 0;
+	virtual HRESULT SetCooperativeLevel(HWND hwnd, DWORD dwFlags) = 0;
+};
+typedef IDirectInputDeviceA* LPDIRECTINPUTDEVICEA;
+
+struct IDirectInputDevice2A : public IDirectInputDeviceA {
+	virtual HRESULT Poll() = 0;
+};
+typedef IDirectInputDevice2A* LPDIRECTINPUTDEVICE2A;
+
+struct IDirectInputA : virtual public IUnknown {
+	virtual HRESULT CreateDevice(
+		const GUID& rguid,
+		LPDIRECTINPUTDEVICEA* lplpDirectInputDevice,
+		IUnknown* pUnkOuter
+	) = 0;
+};
+typedef IDirectInputA* LPDIRECTINPUTA;
+
+// --- Data ---
+extern const DIDATAFORMAT c_dfDIKeyboard;
+
+// --- Functions ---
+HRESULT DirectInputCreateA(HINSTANCE hinst, DWORD dwVersion, LPDIRECTINPUTA* lplpDirectInput, IUnknown* punkOuter);
diff --git a/miniwin/src/dinput/dinput.cpp b/miniwin/src/dinput/dinput.cpp
new file mode 100644
index 0000000..e3c26cb
--- /dev/null
+++ b/miniwin/src/dinput/dinput.cpp
@@ -0,0 +1,95 @@
+#include "dinput_impl.h"
+#include "miniwin.h"
+
+// The keyboard data format's header. Its per-key object table is not provided until
+// IDirectInputDeviceA::SetDataFormat is implemented.
+const DIDATAFORMAT c_dfDIKeyboard = {sizeof(DIDATAFORMAT), sizeof(DIOBJECTDATAFORMAT), DIDF_RELAXIS, 256, 0, nullptr};
+
+HRESULT DirectInputDeviceImpl::QueryInterface(const GUID& riid, void** ppvObject)
+{
+	if (SDL_memcmp(&riid, &IID_IDirectInputDeviceA, sizeof(GUID)) == 0) {
+		this->IUnknown::AddRef();
+		*ppvObject = static_cast<IDirectInputDeviceA*>(this);
+		return DI_OK;
+	}
+	if (SDL_memcmp(&riid, &IID_IDirectInputDevice2A, sizeof(GUID)) == 0) {
+		this->IUnknown::AddRef();
+		*ppvObject = static_cast<IDirectInputDevice2A*>(this);
+		return DI_OK;
+	}
+	MINIWIN_NOT_IMPLEMENTED();
+	return E_NOINTERFACE;
+}
+
+HRESULT DirectInputDeviceImpl::Acquire()
+{
+	MINIWIN_NOT_IMPLEMENTED();
+	return DIERR_UNSUPPORTED;
+}
+
+HRESULT DirectInputDeviceImpl::Unacquire()
+{
+	MINIWIN_NOT_IMPLEMENTED();
+	return DIERR_UNSUPPORTED;
+}
+
+HRESULT DirectInputDeviceImpl::GetDeviceState(DWORD cbData, LPVOID lpvData)
+{
+	MINIWIN_NOT_IMPLEMENTED();
+	return DIERR_UNSUPPORTED;
+}
+
+HRESULT DirectInputDeviceImpl::SetDataFormat(LPCDIDATAFORMAT lpdf)
+{
+	MINIWIN_NOT_IMPLEMENTED();
+	return DIERR_UNSUPPORTED;
+}
+
+HRESULT DirectInputDeviceImpl::SetCooperativeLevel(HWND hwnd, DWORD dwFlags)
+{
+	MINIWIN_NOT_IMPLEMENTED();
+	return DIERR_UNSUPPORTED;
+}
+
+HRESULT DirectInputDeviceImpl::Poll()
+{
+	MINIWIN_NOT_IMPLEMENTED();
+	return DIERR_UNSUPPORTED;
+}
+
+HRESULT DirectInputImpl::QueryInterface(const GUID& riid, void** ppvObject)
+{
+	if (SDL_memcmp(&riid, &IID_IDirectInputA, sizeof(GUID)) == 0) {
+		this->IUnknown::AddRef();
+		*ppvObject = static_cast<IDirectInputA*>(this);
+		return DI_OK;
+	}
+	MINIWIN_NOT_IMPLEMENTED();
+	return E_NOINTERFACE;
+}
+
+HRESULT DirectInputImpl::CreateDevice(
+	const GUID& rguid,
+	LPDIRECTINPUTDEVICEA* lplpDirectInputDevice,
+	IUnknown* pUnkOuter
+)
+{
+	if (!lplpDirectInputDevice) {
+		return DIERR_INVALIDPARAM;
+	}
+	if (SDL_memcmp(&rguid, &GUID_SysKeyboard, sizeof(GUID)) != 0 &&
+		SDL_memcmp(&rguid, &GUID_SysMouse, sizeof(GUID)) != 0) {
+		return DIERR_DEVICENOTREG;
+	}
+	*lplpDirectInputDevice = static_cast<IDirectInputDeviceA*>(new DirectInputDeviceImpl);
+	return DI_OK;
+}
+
+HRESULT DirectInputCreateA(HINSTANCE hinst, DWORD dwVersion, LPDIRECTINPUTA* lplpDirectInput, IUnknown* punkOuter)
+{
+	if (!lplpDirectInput) {
+		return DIERR_INVALIDPARAM;
+	}
+	*lplpDirectInput = new DirectInputImpl;
+	return DI_OK;
+}
diff --git a/miniwin/src/internal/dinput_impl.h b/miniwin/src/internal/dinput_impl.h
new file mode 100644
index 0000000..58934a8
--- /dev/null
+++ b/miniwin/src/internal/dinput_impl.h
@@ -0,0 +1,23 @@
+#pragma once
+
+#include "miniwin/dinput.h"
+
+struct DirectInputDeviceImpl : public IDirectInputDevice2A {
+	// IUnknown interface
+	HRESULT QueryInterface(const GUID& riid, void** ppvObject) override;
+	// IDirectInputDeviceA interface
+	HRESULT Acquire() override;
+	HRESULT Unacquire() override;
+	HRESULT GetDeviceState(DWORD cbData, LPVOID lpvData) override;
+	HRESULT SetDataFormat(LPCDIDATAFORMAT lpdf) override;
+	HRESULT SetCooperativeLevel(HWND hwnd, DWORD dwFlags) override;
+	// IDirectInputDevice2A interface
+	HRESULT Poll() override;
+};
+
+struct DirectInputImpl : public IDirectInputA {
+	// IUnknown interface
+	HRESULT QueryInterface(const GUID& riid, void** ppvObject) override;
+	// IDirectInputA interface
+	HRESULT CreateDevice(const GUID& rguid, LPDIRECTINPUTDEVICEA* lplpDirectInputDevice, IUnknown* pUnkOuter) override;
+};
