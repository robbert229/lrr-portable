-	pixelState.colorKeyEnable = st.Render(D3DRENDERSTATE_COLORKEYENABLE) != 0;
-	pixelState.linear = st.Render(D3DRENDERSTATE_TEXTUREMAG) != static_cast<DWORD>(D3DFILTER_NEAREST);
