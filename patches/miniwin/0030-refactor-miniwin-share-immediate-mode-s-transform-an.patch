new file mode 100644
index 0000000..01b838d
--- /dev/null
+++ b/miniwin/src/internal/immediatemode.cpp
@@ -0,0 +1,273 @@
+#include "immediatemode.h"
+
+#include "ddsurface_impl.h"
+
+#include <algorithm>
+#include <cmath>
+
+void PreparedLights::Prepare(const SceneLight* sceneLights, size_t count)
+{
+	// Fold ambient lights into a single base color and pre-normalize the
+	// directional light vectors so per-vertex lighting does no sqrt for them.
+	lights.clear();
+	ambientR = 0.0f;
+	ambientG = 0.0f;
+	ambientB = 0.0f;
+
+	for (size_t i = 0; i < count; ++i) {
+		const SceneLight& light = sceneLights[i];
+
+		if (light.positional == 0.0f && light.directional == 0.0f) {
+			ambientR += light.color.r;
+			ambientG += light.color.g;
+			ambientB += light.color.b;
+			continue;
+		}
+
+		PreparedLight prepared;
+		prepared.color = light.color;
+		prepared.spot = light.positional == 1.0f && light.directional == 1.0f;
+		prepared.range = light.range;
+		for (int a = 0; a < 3; ++a) {
+			prepared.attenuation[a] = light.attenuation[a];
+		}
+		// D3DRM hands its spot to Direct3D as theta = umbra, phi = penumbra
+		// and falloff 0. Direct3D's theta and phi are full cone angles, and
+		// with falloff 0 the spot is at full strength anywhere inside phi.
+		prepared.cosPenumbra = std::cos(light.penumbra * 0.5f);
+		if (light.directional == 1.0f) {
+			prepared.spotDirection = Normalize(light.direction);
+		}
+		if (light.directional == 1.0f && !prepared.spot) {
+			prepared.positional = false;
+			prepared.vec = Normalize({-light.direction.x, -light.direction.y, -light.direction.z});
+		}
+		else {
+			prepared.positional = true;
+			prepared.vec = light.position;
+		}
+		lights.push_back(prepared);
+	}
+}
+
+float LightReach(const PreparedLight& light, const D3DVECTOR& worldPos, D3DVECTOR& toLight)
+{
+	D3DVECTOR d = {light.vec.x - worldPos.x, light.vec.y - worldPos.y, light.vec.z - worldPos.z};
+	float distance = std::sqrt(DotProduct(d, d));
+	if (distance > light.range) {
+		return 0.0f;
+	}
+	toLight = distance > 0.0f ? D3DVECTOR{d.x / distance, d.y / distance, d.z / distance} : D3DVECTOR{0, 0, 0};
+	float denominator =
+		light.attenuation[0] + light.attenuation[1] * distance + light.attenuation[2] * distance * distance;
+	float reach = denominator > 0.0f ? 1.0f / denominator : 1.0f;
+	if (light.spot) {
+		float rho = -DotProduct(toLight, light.spotDirection);
+		if (rho <= light.cosPenumbra) {
+			return 0.0f;
+		}
+	}
+	return reach;
+}
+
+float ImmediateFogFactor(DWORD mode, float start, float end, float density, float z)
+{
+	float f = 1.0f;
+	switch (static_cast<D3DFOGMODE>(mode)) {
+	case D3DFOG_LINEAR:
+		f = end != start ? (end - z) / (end - start) : (z < start ? 1.0f : 0.0f);
+		break;
+	case D3DFOG_EXP:
+		f = std::exp(-density * z);
+		break;
+	case D3DFOG_EXP2:
+		f = std::exp(-(density * z) * (density * z));
+		break;
+	default:
+		break;
+	}
+	return std::min(1.0f, std::max(0.0f, f));
+}
+
+bool KeyImmediateTexture(const Direct3DRMTextureImpl* texture, SDL_Surface* rgba32)
+{
+	auto surface = static_cast<DirectDrawSurfaceImpl*>(texture->m_surface);
+	bool keyed = SDL_SurfaceHasColorKey(surface->m_surface);
+	if (texture->m_decalTransparency) {
+		keyed = true;
+		const Uint8 r = (texture->m_decalTransparentColor >> 16) & 0xff;
+		const Uint8 g = (texture->m_decalTransparentColor >> 8) & 0xff;
+		const Uint8 b = texture->m_decalTransparentColor & 0xff;
+		for (int y = 0; y < rgba32->h; ++y) {
+			Uint8* px = static_cast<Uint8*>(rgba32->pixels) + y * rgba32->pitch;
+			for (int x = 0; x < rgba32->w; ++x, px += 4) {
+				if (px[0] == r && px[1] == g && px[2] == b) {
+					px[3] = 0;
+				}
+			}
+		}
+	}
+	return keyed;
+}
+
+float ImmediateFloatState(DWORD bits)
+{
+	float value;
+	SDL_memcpy(&value, &bits, sizeof(value));
+	return value;
+}
+
+ImmediateShading DecodeImmediateShading(const ImmediateState& st)
+{
+	ImmediateShading s = {};
+	s.zEnable = st.Render(D3DRENDERSTATE_ZENABLE) != 0;
+	s.zWrite = st.Render(D3DRENDERSTATE_ZWRITEENABLE) != 0;
+	s.zFunc = st.Render(D3DRENDERSTATE_ZFUNC);
+	s.blend = st.Render(D3DRENDERSTATE_ALPHABLENDENABLE) != 0;
+	s.srcBlend = st.Render(D3DRENDERSTATE_SRCBLEND);
+	s.destBlend = st.Render(D3DRENDERSTATE_DESTBLEND);
+	s.cull = st.Render(D3DRENDERSTATE_CULLMODE);
+	s.flat = st.Render(D3DRENDERSTATE_SHADEMODE) == static_cast<DWORD>(D3DSHADE_FLAT);
+	s.colorKeyEnable = st.Render(D3DRENDERSTATE_COLORKEYENABLE) != 0;
+	s.linear = st.Render(D3DRENDERSTATE_TEXTUREMAG) != static_cast<DWORD>(D3DFILTER_NEAREST);
+	const DWORD* tss = st.textureStageState[0];
+	s.colorOp = tss[static_cast<DWORD>(D3DTSS_COLOROP)];
+	s.colorArg1 = tss[static_cast<DWORD>(D3DTSS_COLORARG1)];
+	s.colorArg2 = tss[static_cast<DWORD>(D3DTSS_COLORARG2)];
+	s.alphaOp = tss[static_cast<DWORD>(D3DTSS_ALPHAOP)];
+	s.alphaArg1 = tss[static_cast<DWORD>(D3DTSS_ALPHAARG1)];
+	s.alphaArg2 = tss[static_cast<DWORD>(D3DTSS_ALPHAARG2)];
+	s.specular = st.Render(D3DRENDERSTATE_SPECULARENABLE) != 0;
+	s.fog = ImmediateShading::Fog::None;
+	s.vertexFogMode = st.lightState[static_cast<DWORD>(D3DLIGHTSTATE_FOGMODE)];
+	s.vertexFogStart = ImmediateFloatState(st.lightState[static_cast<DWORD>(D3DLIGHTSTATE_FOGSTART)]);
+	s.vertexFogEnd = ImmediateFloatState(st.lightState[static_cast<DWORD>(D3DLIGHTSTATE_FOGEND)]);
+	s.vertexFogDensity = ImmediateFloatState(st.lightState[static_cast<DWORD>(D3DLIGHTSTATE_FOGDENSITY)]);
+	if (st.Render(D3DRENDERSTATE_FOGENABLE)) {
+		D3DCOLOR fogColor = st.Render(D3DRENDERSTATE_FOGCOLOR);
+		s.fogR = ((fogColor >> 16) & 0xff) / 255.0f;
+		s.fogG = ((fogColor >> 8) & 0xff) / 255.0f;
+		s.fogB = (fogColor & 0xff) / 255.0f;
+		s.fogMode = st.Render(D3DRENDERSTATE_FOGTABLEMODE);
+		if (s.fogMode != static_cast<DWORD>(D3DFOG_NONE)) {
+			s.fog = ImmediateShading::Fog::Table;
+			s.fogStart = ImmediateFloatState(st.Render(D3DRENDERSTATE_FOGTABLESTART));
+			s.fogEnd = ImmediateFloatState(st.Render(D3DRENDERSTATE_FOGTABLEEND));
+			s.fogDensity = ImmediateFloatState(st.Render(D3DRENDERSTATE_FOGTABLEDENSITY));
+		}
+		else if (s.vertexFogMode != static_cast<DWORD>(D3DFOG_NONE)) {
+			s.fog = ImmediateShading::Fog::Vertex;
+		}
+	}
+	return s;
+}
+
+static D3DVECTOR Subtract(const D3DVECTOR& a, const D3DVECTOR& b)
+{
+	return {a.x - b.x, a.y - b.y, a.z - b.z};
+}
+
+bool IsBackface(const D3DVECTOR& v0, const D3DVECTOR& v1, const D3DVECTOR& v2)
+{
+	D3DVECTOR normal = CrossProduct(Subtract(v1, v0), Subtract(v2, v0));
+	return DotProduct(normal, v0) >= 0.0f;
+}
+
+void ImmediateTransformer::Begin(const ImmediateDraw& draw, const PreparedLights& lights, const ImmediateShading& shading)
+{
+	m_draw = &draw;
+	m_lights = &lights;
+	m_shading = &shading;
+
+	D3DRMMATRIX4D modelView;
+	MultiplyMatrix(modelView, draw.world, draw.view);
+	SDL_memcpy(m_worldMatrix, draw.world, sizeof(D3DRMMATRIX4D));
+	NormalMatrix(m_normalMatrix, draw.world);
+
+	// The eye in world space, for the specular half vector (LOCALVIEWER).
+	const D3DRMMATRIX4D& v = draw.view;
+	D3DVECTOR t = {v[3][0], v[3][1], v[3][2]};
+	m_eye = {
+		-(t.x * v[0][0] + t.y * v[0][1] + t.z * v[0][2]),
+		-(t.x * v[1][0] + t.y * v[1][1] + t.z * v[1][2]),
+		-(t.x * v[2][0] + t.y * v[2][1] + t.z * v[2][2])
+	};
+
+	const DWORD vertexCount = draw.vertexCount;
+	m_positions.resize(vertexCount);
+	for (DWORD i = 0; i < vertexCount; ++i) {
+		const D3DVERTEX& vertex = draw.vertices[i];
+		m_positions[i] = TransformPoint({vertex.x, vertex.y, vertex.z}, modelView);
+	}
+	m_colors.resize(vertexCount);
+	m_speculars.resize(vertexCount);
+	m_lit.assign(vertexCount, 0);
+}
+
+// Direct3D's lighting of a D3DFVF_VERTEX with a D3DMATERIAL: emissive, plus
+// ambient light times the material's ambient, plus each light's diffuse and
+// (when wanted) specular. Vertex fog's factor goes in the specular alpha.
+void ImmediateTransformer::Light(WORD index)
+{
+	if (m_lit[index]) {
+		return;
+	}
+	m_lit[index] = 1;
+	const D3DVERTEX& v = m_draw->vertices[index];
+	const D3DMATERIAL& material = m_draw->material;
+	const PreparedLights& lights = *m_lights;
+	const bool specular = m_shading->specular;
+
+	D3DVECTOR normal = Normalize(TransformNormal({v.nx, v.ny, v.nz}, m_normalMatrix));
+	D3DVECTOR worldPos = TransformPoint({v.x, v.y, v.z}, m_worldMatrix);
+	D3DVECTOR toEye = Normalize(Subtract(m_eye, worldPos));
+
+	FColor diffuse = {
+		material.emissive.r + lights.ambientR * material.ambient.r,
+		material.emissive.g + lights.ambientG * material.ambient.g,
+		material.emissive.b + lights.ambientB * material.ambient.b,
+		0
+	};
+	FColor spec = {0, 0, 0, 0};
+	for (const PreparedLight& light : lights.lights) {
+		D3DVECTOR lightVec = light.vec;
+		float reach = 1.0f;
+		if (light.positional) {
+			reach = LightReach(light, worldPos, lightVec);
+			if (reach <= 0.0f) {
+				continue;
+			}
+		}
+		float dotNL = DotProduct(normal, lightVec);
+		if (dotNL <= 0.0f) {
+			continue;
+		}
+		diffuse.r += reach * dotNL * light.color.r * material.diffuse.r;
+		diffuse.g += reach * dotNL * light.color.g * material.diffuse.g;
+		diffuse.b += reach * dotNL * light.color.b * material.diffuse.b;
+		if (specular && material.power > 0.0f) {
+			D3DVECTOR halfway = Normalize({lightVec.x + toEye.x, lightVec.y + toEye.y, lightVec.z + toEye.z});
+			float dotNH = DotProduct(normal, halfway);
+			if (dotNH > 0.0f) {
+				float power = reach * std::pow(dotNH, material.power);
+				spec.r += power * light.color.r * material.specular.r;
+				spec.g += power * light.color.g * material.specular.g;
+				spec.b += power * light.color.b * material.specular.b;
+			}
+		}
+	}
+
+	auto toByte = [](float c) { return static_cast<Uint8>(std::min(255.0f, std::max(0.0f, c * 255.0f + 0.5f))); };
+	m_colors[index] = {toByte(diffuse.r), toByte(diffuse.g), toByte(diffuse.b), toByte(material.diffuse.a)};
+	m_speculars[index] = {toByte(spec.r), toByte(spec.g), toByte(spec.b), 0};
+	if (m_shading->fog == ImmediateShading::Fog::Vertex) {
+		float f = ImmediateFogFactor(
+			m_shading->vertexFogMode,
+			m_shading->vertexFogStart,
+			m_shading->vertexFogEnd,
+			m_shading->vertexFogDensity,
+			m_positions[index].z
+		);
+		m_speculars[index].a = static_cast<Uint8>(f * 255.0f + 0.5f);
+	}
+}
diff --git a/miniwin/src/internal/immediatemode.h b/miniwin/src/internal/immediatemode.h
new file mode 100644
index 0000000..f2edb58
--- /dev/null
+++ b/miniwin/src/internal/immediatemode.h
@@ -0,0 +1,150 @@
+#pragma once
+
+#include "d3drmrenderer.h"
+#include "d3drmtexture_impl.h"
+#include "mathutils.h"
+
+#include <SDL3/SDL.h>
+#include <vector>
+
+// Immediate mode's transform and lighting on the CPU, as a DirectX 6 HAL
+// device without hardware T&L had it done for it: every backend that draws
+// immediate mode lights and culls the same way, and only rasterizes
+// differently.
+
+// A positional or directional scene light, prepared once per PushLights so
+// that per-vertex lighting does no normalization.
+struct PreparedLight {
+	D3DVECTOR vec;           // normalized direction to light (directional) or position (positional)
+	D3DVECTOR spotDirection; // unit direction the spot shines in
+	FColor color;
+	bool positional;
+	bool spot;
+	float range;
+	float attenuation[3];
+	float cosPenumbra; // the spot lights at full strength inside it, nothing outside
+};
+
+// The scene's lights for per-vertex lighting: ambient lights folded into one
+// colour, the others prepared.
+struct PreparedLights {
+	std::vector<PreparedLight> lights;
+	float ambientR = 0.0f;
+	float ambientG = 0.0f;
+	float ambientB = 0.0f;
+
+	void Prepare(const SceneLight* sceneLights, size_t count);
+};
+
+// How much of a positional light reaches worldPos (range, attenuation and
+// spot cone), and the unit vector from worldPos toward the light.
+float LightReach(const PreparedLight& light, const D3DVECTOR& worldPos, D3DVECTOR& toLight);
+
+// Direct3D's fog factor at view depth z: 1 leaves the colour, 0 is all fog.
+float ImmediateFogFactor(DWORD mode, float start, float end, float density, float z);
+
+// Keys an RGBA32 copy of a texture's surface for immediate mode. The colour
+// key already became alpha 0 in the conversion; the decal transparent colour
+// becomes alpha 0 here. Returns whether alpha-0 texels stand for a key rather
+// than for real alpha.
+bool KeyImmediateTexture(const Direct3DRMTextureImpl* texture, SDL_Surface* rgba32);
+
+// A float render or light state, stored in its DWORD's bits.
+float ImmediateFloatState(DWORD bits);
+
+// A vertex after transform and lighting: view-space position, texture
+// coordinates, the lit diffuse colour (alpha from the material) and the
+// specular colour, whose alpha carries the vertex fog factor.
+struct ImmediateLitVertex {
+	D3DVECTOR position;
+	TexCoord texCoord;
+	SDL_Color color;
+	SDL_Color specular;
+};
+
+// What a draw's state asks of the rasterizer, decoded from the device's
+// render, light and texture stage states.
+struct ImmediateShading {
+	bool zEnable, zWrite, blend;
+	DWORD zFunc, srcBlend, destBlend;
+	DWORD cull;
+	bool flat;
+	bool colorKeyEnable, linear;
+	// Stage 0. The stage passes the diffuse colour through when the draw is
+	// untextured or COLOROP is DISABLE.
+	DWORD colorOp, colorArg1, colorArg2, alphaOp, alphaArg1, alphaArg2;
+	bool specular; // SPECULARENABLE: add the vertex specular after stage 0
+	// Fog, blended in last: per vertex (the factor rides in the specular
+	// alpha, as in Direct3D) or per pixel from the view depth.
+	enum class Fog {
+		None,
+		Vertex,
+		Table
+	} fog;
+	DWORD fogMode; // D3DFOGMODE, for table fog
+	float fogStart, fogEnd, fogDensity;
+	float fogR, fogG, fogB;
+	// The vertex fog the light states describe, for Fog::Vertex.
+	DWORD vertexFogMode;
+	float vertexFogStart, vertexFogEnd, vertexFogDensity;
+};
+
+ImmediateShading DecodeImmediateShading(const ImmediateState& state);
+
+// A view-space triangle wound counter-clockwise on screen (a back face to
+// D3DCULL_CCW).
+bool IsBackface(const D3DVECTOR& v0, const D3DVECTOR& v1, const D3DVECTOR& v2);
+
+// Transforms a draw's vertices into view space, culls back faces, and lights
+// the vertices of the triangles that remain, each vertex once.
+class ImmediateTransformer {
+public:
+	// Calls emit(const ImmediateLitVertex (&triangle)[3]) for each triangle
+	// the cull mode keeps, in index order. Flat shading gives the whole
+	// triangle its first vertex's colours.
+	template <typename Emit>
+	void Run(const ImmediateDraw& draw, const PreparedLights& lights, const ImmediateShading& shading, Emit&& emit)
+	{
+		Begin(draw, lights, shading);
+		const bool cullCCW = shading.cull == static_cast<DWORD>(D3DCULL_CCW);
+		const bool cullCW = shading.cull == static_cast<DWORD>(D3DCULL_CW);
+		for (DWORD t = 0; t + 2 < draw.indexCount; t += 3) {
+			const WORD i0 = draw.indices[t];
+			const WORD i1 = draw.indices[t + 1];
+			const WORD i2 = draw.indices[t + 2];
+			const D3DVECTOR& p0 = m_positions[i0];
+			const D3DVECTOR& p1 = m_positions[i1];
+			const D3DVECTOR& p2 = m_positions[i2];
+			// Counter-clockwise on screen is IsBackface's test (D3DCULL_CCW).
+			if ((cullCCW && IsBackface(p0, p1, p2)) || (cullCW && IsBackface(p0, p2, p1))) {
+				continue;
+			}
+			Light(i0);
+			const WORD c1 = shading.flat ? i0 : i1;
+			const WORD c2 = shading.flat ? i0 : i2;
+			Light(c1);
+			Light(c2);
+			const ImmediateLitVertex triangle[3] = {
+				{p0, {draw.vertices[i0].tu, draw.vertices[i0].tv}, m_colors[i0], m_speculars[i0]},
+				{p1, {draw.vertices[i1].tu, draw.vertices[i1].tv}, m_colors[c1], m_speculars[c1]},
+				{p2, {draw.vertices[i2].tu, draw.vertices[i2].tv}, m_colors[c2], m_speculars[c2]},
+			};
+			emit(triangle);
+		}
+	}
+
+private:
+	void Begin(const ImmediateDraw& draw, const PreparedLights& lights, const ImmediateShading& shading);
+	void Light(WORD index);
+
+	const ImmediateDraw* m_draw = nullptr;
+	const PreparedLights* m_lights = nullptr;
+	const ImmediateShading* m_shading = nullptr;
+	D3DRMMATRIX4D m_worldMatrix;
+	Matrix3x3 m_normalMatrix;
+	D3DVECTOR m_eye;
+	std::vector<D3DVECTOR> m_positions;
+	std::vector<SDL_Color> m_colors;
+	std::vector<SDL_Color> m_speculars;
+	std::vector<Uint8> m_lit;
+};
