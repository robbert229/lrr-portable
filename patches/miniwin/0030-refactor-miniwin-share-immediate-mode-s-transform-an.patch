 			pixelState.texHeight = cache.cached->h;
@@ -1679,129 +1489,10 @@ HRESULT Direct3DRMSoftwareRenderer::SubmitImmediate(const ImmediateDraw& draw)
 			pixelState.keyed = cache.keyed;
 		}
