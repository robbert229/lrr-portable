-					f = FogFactor(state.fogMode, state.fogStart, state.fogEnd, state.fogDensity, 1.0f / oow);
+					f = ImmediateFogFactor(state.fogMode, state.fogStart, state.fogEnd, state.fogDensity, 1.0f / oow);
 				}
