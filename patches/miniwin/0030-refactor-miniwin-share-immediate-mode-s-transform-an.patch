-	for (size_t i = 0; i < m_preparedLights.size(); ++i) {
-		const PreparedLight& light = m_preparedLights[i];
+	for (size_t i = 0; i < m_lights.lights.size(); ++i) {
+		const PreparedLight& light = m_lights.lights[i];
 
 		D3DVECTOR lightVec;
 		float reach = 1.0f;
@@ -385,13 +321,6 @@ inline D3DVECTOR Subtract(const D3DVECTOR& a, const D3DVECTOR& b)
 	return {a.x - b.x, a.y - b.y, a.z - b.z};
 }
 
