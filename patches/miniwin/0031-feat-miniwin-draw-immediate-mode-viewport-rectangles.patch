diff --git a/miniwin/src/d3drm/backends/sdl3gpu/shaders/src/ImmediatePixel.frag.hlsl b/miniwin/src/d3drm/backends/sdl3gpu/shaders/src/ImmediatePixel.frag.hlsl
new file mode 100644
index 0000000..015b802
--- /dev/null
+++ b/miniwin/src/d3drm/backends/sdl3gpu/shaders/src/ImmediatePixel.frag.hlsl
@@ -0,0 +1,209 @@
+#include "Common.hlsl"
+
+// Immediate mode's pixel pipeline: texture stage 0, the specular colour and
+// fog, as the software backend computes them. Blending and the depth test
+// are the pipeline's.
+
+// Direct3D's values for the states this shader reads.
+#define D3DTA_SELECTMASK 0x0f
+#define D3DTA_TEXTURE 0x02
+#define D3DTA_TFACTOR 0x03
+#define D3DTA_SPECULAR 0x04
+#define D3DTA_COMPLEMENT 0x10
+#define D3DTA_ALPHAREPLICATE 0x20
+
+#define D3DTOP_DISABLE 1
+#define D3DTOP_SELECTARG1 2
+#define D3DTOP_SELECTARG2 3
+#define D3DTOP_MODULATE 4
+#define D3DTOP_MODULATE2X 5
+#define D3DTOP_MODULATE4X 6
+#define D3DTOP_ADD 7
+
+#define D3DFOG_EXP 1
+#define D3DFOG_EXP2 2
+#define D3DFOG_LINEAR 3
+
+#define FOG_NONE 0
+#define FOG_VERTEX 1
+#define FOG_TABLE 2
+
+cbuffer ImmediateShadingData : REGISTER_SPACE(b0, space3)
+{
+	int UseTexture;
+	int Keyed;          // alpha-0 texels stand for a colour key
+	int ColorKeyEnable; // and are not drawn
+	int Linear;
+	int ColorOp;
+	int ColorArg1;
+	int ColorArg2;
+	int AlphaOp;
+	int AlphaArg1;
+	int AlphaArg2;
+	int SpecularEnable;
+	int FogKind;
+	int FogMode;
+	float FogStart;
+	float FogEnd;
+	float FogDensity;
+	float4 FogColor;
+	int2 TextureSize;
+	float DiffuseAlpha; // the material's, for the whole draw
+	int Padding;
+}
+
+Texture2D<float4> Texture : REGISTER_SPACE(t0, space2);
+SamplerState Sampler : REGISTER_SPACE(s0, space2);
+
+float4 Texel(int x, int y)
+{
+	x %= TextureSize.x;
+	y %= TextureSize.y;
+	x += x < 0 ? TextureSize.x : 0;
+	y += y < 0 ? TextureSize.y : 0;
+	return Texture.Load(int3(x, y, 0));
+}
+
+// Stage 0's texel at (u, v), wrapped, point or bilinear. A keyed texture's
+// alpha-0 texels are the colour key: with COLORKEYENABLE they are not drawn
+// (and do not bleed into a filtered neighbour), and the texels that are drawn
+// are opaque.
+float4 SampleTexture(float2 uv, out bool discardTexel)
+{
+	discardTexel = false;
+	float fx = uv.x * TextureSize.x;
+	float fy = uv.y * TextureSize.y;
+	if (Linear == 0) {
+		float4 t = Texel((int) floor(fx), (int) floor(fy));
+		if (Keyed != 0) {
+			discardTexel = ColorKeyEnable != 0 && t.a == 0.0;
+			t.a = 1.0;
+		}
+		return t;
+	}
+
+	fx -= 0.5;
+	fy -= 0.5;
+	float x0 = floor(fx);
+	float y0 = floor(fy);
+	float ax = fx - x0;
+	float ay = fy - y0;
+	int ix = (int) x0;
+	int iy = (int) y0;
+	float4 t[4] = {Texel(ix, iy), Texel(ix + 1, iy), Texel(ix, iy + 1), Texel(ix + 1, iy + 1)};
+	float w[4] = {(1 - ax) * (1 - ay), ax * (1 - ay), (1 - ax) * ay, ax * ay};
+	bool keyOut = Keyed != 0 && ColorKeyEnable != 0;
+	float4 o = float4(0, 0, 0, 0);
+	float coverage = 0.0;
+	for (int i = 0; i < 4; ++i) {
+		float wi = keyOut ? w[i] * t[i].a : w[i];
+		o.rgb += wi * t[i].rgb;
+		o.a += w[i] * t[i].a;
+		coverage += wi;
+	}
+	if (keyOut) {
+		if (coverage < 0.5) {
+			discardTexel = true;
+			return o;
+		}
+		return float4(o.rgb / coverage, 1.0);
+	}
+	if (Keyed != 0) {
+		o.a = 1.0;
+	}
+	return o;
+}
+
+// A texture stage argument. Stage 0's CURRENT is the diffuse colour.
+float StageArg(int arg, float diffuse, float texel, float diffuseAlpha, float texelAlpha)
+{
+	bool alpha = (arg & D3DTA_ALPHAREPLICATE) != 0;
+	float value;
+	switch (arg & D3DTA_SELECTMASK) {
+	case D3DTA_TEXTURE:
+		value = alpha ? texelAlpha : texel;
+		break;
+	case D3DTA_TFACTOR:
+		value = 1.0;
+		break;
+	case D3DTA_SPECULAR:
+		value = 0.0;
+		break;
+	default: // DIFFUSE, CURRENT
+		value = alpha ? diffuseAlpha : diffuse;
+		break;
+	}
+	return (arg & D3DTA_COMPLEMENT) != 0 ? 1.0 - value : value;
+}
+
+float StageOp(int op, float arg1, float arg2, float current)
+{
+	switch (op) {
+	case D3DTOP_DISABLE:
+		return current;
+	case D3DTOP_SELECTARG1:
+		return arg1;
+	case D3DTOP_SELECTARG2:
+		return arg2;
+	case D3DTOP_MODULATE2X:
+		return min(1.0, 2.0 * arg1 * arg2);
+	case D3DTOP_MODULATE4X:
+		return min(1.0, 4.0 * arg1 * arg2);
+	case D3DTOP_ADD:
+		return min(1.0, arg1 + arg2);
+	default: // MODULATE
+		return arg1 * arg2;
+	}
+}
+
+float Stage(int op, int arg1, int arg2, float diffuse, float texel, float diffuseAlpha, float texelAlpha)
+{
+	return StageOp(
+		op,
+		StageArg(arg1, diffuse, texel, diffuseAlpha, texelAlpha),
+		StageArg(arg2, diffuse, texel, diffuseAlpha, texelAlpha),
+		diffuse
+	);
+}
+
+// Direct3D's fog factor at view depth z: 1 leaves the colour, 0 is all fog.
+float FogFactor(float z)
+{
+	float f = 1.0;
+	if (FogMode == D3DFOG_LINEAR) {
+		f = FogEnd != FogStart ? (FogEnd - z) / (FogEnd - FogStart) : (z < FogStart ? 1.0 : 0.0);
+	}
+	else if (FogMode == D3DFOG_EXP) {
+		f = exp(-FogDensity * z);
+	}
+	else if (FogMode == D3DFOG_EXP2) {
+		f = exp(-(FogDensity * z) * (FogDensity * z));
+	}
+	return saturate(f);
+}
+
+float4 main(FS_ImmediateInput input) : SV_Target0
+{
+	float3 color = input.Diffuse.rgb;
+	float alpha = DiffuseAlpha;
+
+	if (UseTexture != 0) {
+		bool discardTexel;
+		float4 t = SampleTexture(input.TexCoord, discardTexel);
+		if (discardTexel) {
+			discard;
+		}
+		color.r = Stage(ColorOp, ColorArg1, ColorArg2, color.r, t.r, DiffuseAlpha, t.a);
+		color.g = Stage(ColorOp, ColorArg1, ColorArg2, color.g, t.g, DiffuseAlpha, t.a);
+		color.b = Stage(ColorOp, ColorArg1, ColorArg2, color.b, t.b, DiffuseAlpha, t.a);
+		alpha = Stage(AlphaOp, AlphaArg1, AlphaArg2, DiffuseAlpha, t.a, DiffuseAlpha, t.a);
+	}
+	if (SpecularEnable != 0) {
+		color = min(float3(1, 1, 1), color + input.Specular.rgb);
+	}
+	if (FogKind != FOG_NONE) {
+		float f = FogKind == FOG_VERTEX ? input.Specular.a : FogFactor(input.ViewZ);
+		color = f * color + (1.0 - f) * FogColor.rgb;
+	}
+	return float4(color, alpha);
+}
