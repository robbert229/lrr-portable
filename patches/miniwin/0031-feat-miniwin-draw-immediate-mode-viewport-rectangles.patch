+#include "Common.hlsl"
+
+// Immediate mode's vertices arrive transformed, lit and in clip space: the
+// CPU does Direct3D's transform and lighting, as for a DirectX 6 HAL device
+// without hardware T&L.
+struct IM_VS_Input
+{
+    float4 Position : TEXCOORD0; // clip space, Direct3D's z in [0, w]
+    float4 Diffuse  : TEXCOORD1;
+    float4 Specular : TEXCOORD2; // alpha carries the vertex fog factor
+    float2 TexCoord : TEXCOORD3;
+};
+
+FS_ImmediateInput main(IM_VS_Input input)
+{
+	FS_ImmediateInput output;
+	// The depth buffer holds 1 - z, so that clearing it to 0 is the far
+	// plane for immediate and retained-mode draws alike.
+	output.Position = float4(input.Position.x, input.Position.y, input.Position.w - input.Position.z, input.Position.w);
+	output.Diffuse = input.Diffuse;
+	output.Specular = input.Specular;
+	output.TexCoord = input.TexCoord;
+	output.ViewZ = input.Position.w;
+	return output;
+}
