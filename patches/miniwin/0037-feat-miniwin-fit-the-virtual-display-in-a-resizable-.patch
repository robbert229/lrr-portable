@@ -0,0 +1,79 @@
+#pragma once
+
+struct SDL_Window;
+
+// How miniwin shows its virtual display in the window.
+//
+// The virtual display is the size the client draws in: the DirectDraw
+// display mode, or, in a window, the window's size when the primary surface
+// was made. The window may later be resized, or made full screen at the
+// desktop's size. miniwin then fits the virtual display into the window:
+// the largest rectangle of the virtual display's aspect, centred, with bars
+// at the sides (pillarboxing) or above and below (letterboxing).
+//
+// - The 3D device renders at the window's pixel size, unless
+//   Miniwin_SetRenderResolution asks for the virtual display's size.
+// - The mouse messages, GetCursorPos and SetCursorPos use virtual display
+//   coordinates. A point over a bar lies outside the virtual display: its
+//   coordinates are negative, or past the display's width or height.
+
+// The fit of a virtual display in a window: a point (x, y) of the virtual
+// display is at (x * scale + offsetX, y * scale + offsetY) in the window's
+// pixels.
+struct ViewportTransform {
+	float scale;
+	float offsetX;
+	float offsetY;
+};
+
+// The largest rectangle of virtualW:virtualH that fits in windowW x windowH,
+// centred.
+ViewportTransform Miniwin_FitTransform(int virtualW, int virtualH, int windowW, int windowH);
+
+// Where the 3D device renders.
+enum class MiniwinRenderResolution {
+	// The window's pixels: the 3D view at the window's resolution (or the
+	// largest area of the virtual display's aspect in it). The default.
+	Window,
+	// The virtual display's pixels, at most: the whole picture is drawn at
+	// the virtual display's resolution and scaled to fit when presented.
+	Virtual,
+};
+
+// Applies to 3D devices made, or windows resized, after the call.
+void Miniwin_SetRenderResolution(MiniwinRenderResolution resolution);
+MiniwinRenderResolution Miniwin_GetRenderResolution();
+
+// Whether a D3DRM viewport that covers the whole virtual display widens
+// into the bars: its projection takes the window's aspect, so a wider window
+// shows more of the scene at the sides (true, the default). False keeps it
+// to the virtual display's aspect and its fit in the window, so the 3D view
+// is framed exactly as the virtual display frames it, and D3DRM's Transform
+// and InverseTransform agree with the picture at any window size. Applies
+// to viewports whose projection is set after the call.
+void Miniwin_SetViewportsFillWindow(bool fill);
+bool Miniwin_GetViewportsFillWindow();
+
+// The size, in pixels, of a render target for a window of windowW x windowH
+// pixels showing a virtualW x virtualH display at `resolution`: the window's
+// size for Window; for Virtual, the window's aspect with the virtual display
+// at a scale of at most one.
+void Miniwin_RenderSize(
+	MiniwinRenderResolution resolution,
+	int virtualW,
+	int virtualH,
+	int windowW,
+	int windowH,
+	int* renderW,
+	int* renderH
+);
+
+// A point in the window, in SDL's window coordinates (points, as mouse
+// events report them), as a point of the virtual display, by the fit of the
+// virtual display in `window` (Miniwin_FitTransform, at the window's pixel
+// density). Unchanged for a window that shows no virtual display.
+void Miniwin_WindowToVirtual(SDL_Window* window, float x, float y, float* virtualX, float* virtualY);
+
+// The inverse: the window point, in SDL's window coordinates, at the centre
+// of the virtual display's pixel (x, y).
+void Miniwin_VirtualToWindow(SDL_Window* window, int x, int y, float* windowX, float* windowY);
