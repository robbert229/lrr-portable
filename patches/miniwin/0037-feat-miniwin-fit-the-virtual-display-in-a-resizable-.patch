-	int x1 = static_cast<int>(std::round(dstRect.x * m_viewportTransform.scale + m_viewportTransform.offsetX));
-	int y1 = static_cast<int>(std::round(dstRect.y * m_viewportTransform.scale + m_viewportTransform.offsetY));
-	int x2 = x1 + static_cast<int>(std::round(dstRect.w * m_viewportTransform.scale));
-	int y2 = y1 + static_cast<int>(std::round(dstRect.h * m_viewportTransform.scale));
-	x1 = std::max(0, std::min(x1, m_width));
-	y1 = std::max(0, std::min(y1, m_height));
-	x2 = std::max(x1, std::min(x2, m_width));
-	y2 = std::max(y1, std::min(y2, m_height));
+	// Clamp the scissor to the virtual display's pixels in the render target:
+	// Metal and Vulkan reject a scissor with a negative origin, so an image
+	// partly above or left of the screen would otherwise not draw at all,
+	// and an image past the display's edge would draw into the bars.
+	SDL_Rect fit = GetFitRect();
+	x1 = std::max(fit.x, std::min(x1, fit.x + fit.w));
+	y1 = std::max(fit.y, std::min(y1, fit.y + fit.h));
+	x2 = std::max(x1, std::min(x2, fit.x + fit.w));
+	y2 = std::max(y1, std::min(y2, fit.y + fit.h));
 	if (x2 == x1 || y2 == y1) {
 		return;
 	}
@@ -1338,10 +1359,11 @@ SDL_Rect Direct3DRMSDL3GPURenderer::ToRenderPixels(const D3DRECT& rect) const
 	int y1 = static_cast<int>(std::lround(rect.y1 * scale + m_viewportTransform.offsetY));
 	int x2 = static_cast<int>(std::lround(rect.x2 * scale + m_viewportTransform.offsetX));
 	int y2 = static_cast<int>(std::lround(rect.y2 * scale + m_viewportTransform.offsetY));
-	x1 = std::max(0, std::min(x1, m_width));
-	y1 = std::max(0, std::min(y1, m_height));
-	x2 = std::max(x1, std::min(x2, m_width));
-	y2 = std::max(y1, std::min(y2, m_height));
+	SDL_Rect fit = GetFitRect();
+	x1 = std::max(fit.x, std::min(x1, fit.x + fit.w));
+	y1 = std::max(fit.y, std::min(y1, fit.y + fit.h));
+	x2 = std::max(x1, std::min(x2, fit.x + fit.w));
+	y2 = std::max(y1, std::min(y2, fit.y + fit.h));
 	return {x1, y1, x2 - x1, y2 - y1};
 }
 
