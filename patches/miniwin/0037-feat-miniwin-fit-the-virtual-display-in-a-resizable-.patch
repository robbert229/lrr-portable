index fc12e3a..a843b37 100644
--- a/miniwin/src/internal/d3drmrenderer.h
+++ b/miniwin/src/internal/d3drmrenderer.h
@@ -109,6 +109,21 @@ class Direct3DRMRenderer : public IDirect3DDevice3 {
 	virtual Uint32 GetTextureId(IDirect3DRMTexture* texture, bool isUI = false, float scaleX = 0, float scaleY = 0) = 0;
 	virtual Uint32 GetMeshId(IDirect3DRMMesh* mesh, const MeshGroup* meshGroup) = 0;
 	int GetWidth() { return m_width; }
+	// The virtual display's fit in the render target, and the pixels it
+	// covers there. Nothing is drawn outside them, so the bars stay black.
+	ViewportTransform GetViewportTransform() const { return m_viewportTransform; }
+	SDL_Rect GetFitRect() const
+	{
+		int x1 = (int) SDL_lroundf(m_viewportTransform.offsetX);
+		int y1 = (int) SDL_lroundf(m_viewportTransform.offsetY);
+		int x2 = (int) SDL_lroundf(m_viewportTransform.offsetX + m_virtualWidth * m_viewportTransform.scale);
+		int y2 = (int) SDL_lroundf(m_viewportTransform.offsetY + m_virtualHeight * m_viewportTransform.scale);
