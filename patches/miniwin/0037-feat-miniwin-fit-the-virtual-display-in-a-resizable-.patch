diff --git a/miniwin/src/ddraw/presentation.cpp b/miniwin/src/ddraw/presentation.cpp
new file mode 100644
index 0000000..f018653
--- /dev/null
+++ b/miniwin/src/ddraw/presentation.cpp
@@ -0,0 +1,162 @@
+#include "presentation_impl.h"
+
+#include <SDL3/SDL.h>
+#include <cmath>
+
+namespace {
+
+MiniwinRenderResolution g_renderResolution = MiniwinRenderResolution::Window;
+bool g_viewportsFillWindow = true;
+
+struct VirtualDisplay {
+	SDL_Window* window;
+	int width;
+	int height;
+};
+
+VirtualDisplay g_virtualDisplay = {nullptr, 0, 0};
+
+float PixelDensity(SDL_Window* window)
+{
+	float density = SDL_GetWindowPixelDensity(window);
+	return density > 0.0f ? density : 1.0f;
+}
+
+} // namespace
+
+ViewportTransform Miniwin_FitTransform(int virtualW, int virtualH, int windowW, int windowH)
+{
+	if (virtualW <= 0 || virtualH <= 0 || windowW <= 0 || windowH <= 0) {
+		return {1.0f, 0.0f, 0.0f};
+	}
+	float scaleX = (float) windowW / virtualW;
+	float scaleY = (float) windowH / virtualH;
+	float scale = (scaleX < scaleY) ? scaleX : scaleY;
+
+	float viewportW = virtualW * scale;
+	float viewportH = virtualH * scale;
+
+	float offsetX = (windowW - viewportW) * 0.5f;
+	float offsetY = (windowH - viewportH) * 0.5f;
+
+	return {scale, offsetX, offsetY};
+}
+
+void Miniwin_SetRenderResolution(MiniwinRenderResolution resolution)
+{
+	g_renderResolution = resolution;
+}
+
+MiniwinRenderResolution Miniwin_GetRenderResolution()
+{
+	return g_renderResolution;
+}
+
+void Miniwin_SetViewportsFillWindow(bool fill)
+{
+	g_viewportsFillWindow = fill;
+}
+
+bool Miniwin_GetViewportsFillWindow()
+{
+	return g_viewportsFillWindow;
+}
+
+void Miniwin_RenderSize(
+	MiniwinRenderResolution resolution,
+	int virtualW,
+	int virtualH,
+	int windowW,
+	int windowH,
+	int* renderW,
+	int* renderH
+)
+{
+	*renderW = windowW;
+	*renderH = windowH;
+	if (resolution != MiniwinRenderResolution::Virtual || virtualW <= 0 || virtualH <= 0 || windowW <= 0 ||
+		windowH <= 0) {
+		return;
+	}
+	// The window's aspect, with the virtual display at a scale of at most
+	// one: as wide as the virtual display when the window is narrower than
+	// it, else as tall.
+	float aspect = (float) windowW / windowH;
+	float virtualAspect = (float) virtualW / virtualH;
+	if (aspect > virtualAspect) {
+		*renderH = SDL_min(windowH, virtualH);
+		*renderW = SDL_max(1, (int) std::lround(*renderH * aspect));
+	}
+	else {
+		*renderW = SDL_min(windowW, virtualW);
+		*renderH = SDL_max(1, (int) std::lround(*renderW / aspect));
+	}
+}
+
+void Miniwin_SetVirtualDisplay(SDL_Window* window, int width, int height)
+{
+	g_virtualDisplay = {window, width, height};
+}
+
+void Miniwin_ClearVirtualDisplay(SDL_Window* window)
+{
+	if (g_virtualDisplay.window == window) {
+		g_virtualDisplay = {nullptr, 0, 0};
+	}
+}
+
+bool Miniwin_GetVirtualDisplay(SDL_Window* window, int* width, int* height)
+{
+	if (!window || g_virtualDisplay.window != window || g_virtualDisplay.width <= 0 ||
+		g_virtualDisplay.height <= 0) {
+		return false;
+	}
+	*width = g_virtualDisplay.width;
+	*height = g_virtualDisplay.height;
+	return true;
+}
+
+bool Miniwin_WindowPixelSize(SDL_Window* window, int* width, int* height)
+{
+	*width = 0;
+	*height = 0;
+	if (window) {
+		SDL_GetWindowSizeInPixels(window, width, height);
+	}
+	bool sized = *width > 0 && *height > 0;
+	*width = SDL_max(*width, 1);
+	*height = SDL_max(*height, 1);
+	return sized;
+}
+
+void Miniwin_WindowToVirtual(SDL_Window* window, float x, float y, float* virtualX, float* virtualY)
+{
+	*virtualX = x;
+	*virtualY = y;
+	int virtualW, virtualH;
+	if (!Miniwin_GetVirtualDisplay(window, &virtualW, &virtualH)) {
+		return;
+	}
+	int windowW, windowH;
+	Miniwin_WindowPixelSize(window, &windowW, &windowH);
+	ViewportTransform fit = Miniwin_FitTransform(virtualW, virtualH, windowW, windowH);
+	float density = PixelDensity(window);
+	*virtualX = (x * density - fit.offsetX) / fit.scale;
+	*virtualY = (y * density - fit.offsetY) / fit.scale;
+}
+
+void Miniwin_VirtualToWindow(SDL_Window* window, int x, int y, float* windowX, float* windowY)
+{
+	*windowX = (float) x;
+	*windowY = (float) y;
+	int virtualW, virtualH;
+	if (!Miniwin_GetVirtualDisplay(window, &virtualW, &virtualH)) {
+		return;
+	}
+	int windowW, windowH;
+	Miniwin_WindowPixelSize(window, &windowW, &windowH);
+	ViewportTransform fit = Miniwin_FitTransform(virtualW, virtualH, windowW, windowH);
+	float density = PixelDensity(window);
+	*windowX = ((x + 0.5f) * fit.scale + fit.offsetX) / density;
+	*windowY = ((y + 0.5f) * fit.scale + fit.offsetY) / density;
+}
