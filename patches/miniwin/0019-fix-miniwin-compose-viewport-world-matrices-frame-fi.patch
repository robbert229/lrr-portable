From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Rowley <johnrowleyster@gmail.com>
Date: Fri, 20 Nov 2026 01:24:43 -0800
Subject: [PATCH] fix(miniwin): compose viewport world matrices frame-first, as
 D3DRM does

D3DRM transforms are row-vector matrices: a point goes through its own
frame's transform and then its parent's, so a frame's world matrix is
local * parent. The viewport's mesh walk, light walk and camera matrix
multiplied parent * local, which agrees only while no parent frame
rotates. Frame3::GetTransform already composes local * parent; the
viewport now matches it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/miniwin/src/d3drm/d3drmviewport.cpp b/miniwin/src/d3drm/d3drmviewport.cpp
index 8572035..8a44c38 100644
--- a/miniwin/src/d3drm/d3drmviewport.cpp
+++ b/miniwin/src/d3drm/d3drmviewport.cpp
@@ -114,7 +114,7 @@ static void ComputeFrameWorldMatrix(IDirect3DRMFrame* frame, D3DRMMATRIX4D out)
 	while (cur) {
 		auto* impl = static_cast<Direct3DRMFrameImpl*>(cur);
 		D3DRMMATRIX4D tmp;
-		D3DRMMatrixMultiply(tmp, impl->m_transform, acc);
+		D3DRMMatrixMultiply(tmp, acc, impl->m_transform);
 		memcpy(acc, tmp, sizeof(acc));
 
 		if (cur == impl->m_parent) {
@@ -132,8 +132,10 @@ void Direct3DRMViewportImpl::CollectLightsFromFrame(
 )
 {
 	auto* frameImpl = static_cast<Direct3DRMFrameImpl*>(frame);
+	// Row vectors, as D3DRM: a point goes through the frame's own transform
+	// first, then its parent's.
 	D3DRMMATRIX4D worldMatrix;
-	D3DRMMatrixMultiply(worldMatrix, parentToWorld, frameImpl->m_transform);
+	D3DRMMatrixMultiply(worldMatrix, frameImpl->m_transform, parentToWorld);
 
 	IDirect3DRMLightArray* lightArray = nullptr;
 	frame->GetLights(&lightArray);
@@ -256,7 +258,7 @@ void Direct3DRMViewportImpl::CollectMeshesFromFrame(IDirect3DRMFrame* frame, D3D
 	memcpy(localMatrix, frameImpl->m_transform, sizeof(D3DRMMATRIX4D));
 
 	D3DRMMATRIX4D worldMatrix;
-	D3DRMMatrixMultiply(worldMatrix, parentMatrix, localMatrix);
+	D3DRMMatrixMultiply(worldMatrix, localMatrix, parentMatrix);
 
 	Matrix3x3 worldMatrixInvert;
 	D3DRMMatrixInvertForNormal(worldMatrixInvert, worldMatrix);
