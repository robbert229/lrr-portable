/* The matching build's resources: version.rc's, then the original's icon
 * group 113 and its icon 1, in English (UK), after the dialog as in the
 * original's resource data. The build extracts LegoRR.ico from the original
 * executable into the build directory (tools/pe_stamps.py); it is licensed
 * art and never committed. ReproBit's build compiles version.rc alone. */
#include "version.rc"

LANGUAGE 0x09, 0x02 /* LANG_ENGLISH, SUBLANG_ENGLISH_UK */
113 ICON "LegoRR.ico"
