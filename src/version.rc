/* Minimal version resource so the stub exe carries sane file properties.
 * The shipped binary's .rsrc is only 3 KB (finding 01); a full icon/splash
 * resource set is not needed for the smoke test. */
/* Keep this RC self-contained: windows.h pulls in unrelated SDK headers that
 * the classic resource scanner does not need to inspect. Values match the
 * MSVC 5.0 winver.h definitions. */
#define VS_VERSION_INFO 1
#define VOS__WINDOWS32  0x00000004L
#define VFT_APP         0x00000001L
#define VFT2_UNKNOWN    0x00000000L

/* The matching build (LRR_RECCMP) defines LRR_ORIGINAL_RESOURCES: it carries
 * the original's resources only, with no VERSIONINFO (#560, finding 651). */
#ifndef LRR_ORIGINAL_RESOURCES
VS_VERSION_INFO VERSIONINFO
 FILEVERSION     0,1,0,0
 PRODUCTVERSION  0,1,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS__WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "lrr-portable (interoperability research)"
            VALUE "FileDescription",  "Lego Rock Raiders reconstruction (stub)"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "LegoRR"
            VALUE "OriginalFilename", "LegoRR.exe"
            VALUE "ProductName",      "lrr-portable"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
#endif

/* Retail resource 101 (Mode Selection), recovered from the shipped
 * executable. The controls and their IDs match the DirectDraw dialog code. */
101 DIALOG 0, 0, 242, 166
STYLE 0x80C800C0
CAPTION "Mode Selection"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON "OK", 1, 65, 145, 50, 14, 0x50010001
    PUSHBUTTON "Cancel", 2, 125, 145, 50, 14, 0x50010000
    LISTBOX 1000, 5, 15, 230, 30, 0x50A10101
    LISTBOX 1002, 5, 60, 230, 35, 0x50A10101
    LISTBOX 1003, 100, 100, 135, 40, 0x50A10101
    LTEXT "Device", -1, 5, 50, 230, 8, 0x50020000
    LTEXT "Driver", -1, 5, 5, 230, 8, 0x50020000
    LTEXT "Screen Modes", 1006, 5, 100, 89, 8, 0x50020002
    AUTORADIOBUTTON "Full Screen", 1004, 5, 115, 51, 10, 0x50000009
    AUTORADIOBUTTON "Window", 1005, 5, 125, 42, 10, 0x50000009
END

#ifdef LRR_ORIGINAL_RESOURCES
/* The original's icon group 113 and its icon 1, in English (UK), after the
 * dialog as in the original's resource data. The build extracts LegoRR.ico
 * from the original executable into the build directory (tools/pe_stamps.py);
 * it is licensed art and never committed. */
LANGUAGE 0x09, 0x02 /* LANG_ENGLISH, SUBLANG_ENGLISH_UK */
113 ICON "LegoRR.ico"
#endif
