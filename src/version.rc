/* Minimal version resource so the stub exe carries sane file properties.
 * The shipped binary's .rsrc is only 3 KB (finding 01); a full icon/splash
 * resource set is not needed for the smoke test. */
#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     0,1,0,0
 PRODUCTVERSION  0,1,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS__WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "lrr-portable (interoperability research)"
            VALUE "FileDescription",  "Lego Rock Raiders reconstruction (stub)"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "LegoRR"
            VALUE "OriginalFilename", "LegoRR.exe"
            VALUE "ProductName",      "lrr-portable"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END