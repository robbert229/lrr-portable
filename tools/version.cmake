#
# Writes lrr_version.h, the version the game reports (docs/releasing.md).
# CMakeLists.txt runs this script at every build:
#
#   cmake -DSOURCE_DIR=<checkout> -DVERSION=<project version>
#         [-DOVERRIDE=<string>] -DOUTPUT=<header> -P tools/version.cmake
#
# VERSION is project(VERSION) in CMakeLists.txt, the one place the version is
# set. The header holds:
#   - OVERRIDE, when it is not empty;
#   - VERSION, when HEAD is the release tag v<VERSION>;
#   - <VERSION>-dev+g<commit> in any other git checkout;
#   - VERSION when there is no git checkout (a source archive, the Flatpak).
# A checkout with uncommitted changes to tracked files appends ".dirty" to the
# build metadata (<VERSION>+dirty at the tag). The header is rewritten only
# when it changes, so a build that changes nothing recompiles nothing.
foreach(_var IN ITEMS SOURCE_DIR VERSION OUTPUT)
  if(NOT DEFINED ${_var} OR "${${_var}}" STREQUAL "")
    message(FATAL_ERROR "version.cmake: ${_var} is not set")
  endif()
endforeach()

set(_version "${VERSION}")
if(NOT "${OVERRIDE}" STREQUAL "")
  set(_version "${OVERRIDE}")
elseif(EXISTS "${SOURCE_DIR}/.git")
  find_package(Git QUIET)
  if(GIT_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse --short=8 HEAD
      OUTPUT_VARIABLE _commit RESULT_VARIABLE _status
      OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(_status EQUAL 0)
      execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}"
        describe --tags --exact-match --match "v${VERSION}" HEAD
        RESULT_VARIABLE _untagged OUTPUT_QUIET ERROR_QUIET)
      execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}"
        status --porcelain --untracked-files=no --ignore-submodules=all
        OUTPUT_VARIABLE _changes RESULT_VARIABLE _status
        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
      set(_metadata "")
      if(NOT _untagged EQUAL 0)
        set(_version "${VERSION}-dev")
        set(_metadata "g${_commit}")
      endif()
      if(_status EQUAL 0 AND NOT "${_changes}" STREQUAL "")
        if(_metadata STREQUAL "")
          set(_metadata "dirty")
        else()
          string(APPEND _metadata ".dirty")
        endif()
      endif()
      if(NOT _metadata STREQUAL "")
        string(APPEND _version "+${_metadata}")
      endif()
    endif()
  endif()
endif()

set(_text "/* Generated by tools/version.cmake; do not edit. */\n#define LRR_VERSION \"${_version}\"\n")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" _old)
else()
  set(_old "")
endif()
if(NOT _old STREQUAL _text)
  file(WRITE "${OUTPUT}" "${_text}")
endif()
